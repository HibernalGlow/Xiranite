{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "src/generated/**/*.ts",
    "src/index.ts",
    "src/definition.ts",
    "src/core.ts",
    "src/platform.ts",
    "src/cli.ts",
    "src/help.ts",
    "src/mcp-client.ts",
    "src/worker-manager.ts"
  ]
}
