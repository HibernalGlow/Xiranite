{
  "definitionVersion": 1,
  "nodeId": "recycleu",
  "title": {
    "zh": "Recycleu",
    "en": "Recycleu"
  },
  "description": {
    "zh": "立即清空 Windows 回收站，或按有限时长定时清空。",
    "en": "Empty the Windows recycle bin immediately or on a bounded timer."
  },
  "actions": [
    {
      "id": "status",
      "label": {
        "zh": "检查状态",
        "en": "Environment status"
      }
    },
    {
      "id": "clean_now",
      "label": {
        "zh": "立即清空一次",
        "en": "Empty once"
      }
    },
    {
      "id": "start",
      "label": {
        "zh": "启动自动清理",
        "en": "Schedule auto-clean"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "工作流",
        "en": "Workflow"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "status"
          },
          "label": {
            "zh": "检查状态",
            "en": "Environment status"
          }
        },
        {
          "value": {
            "text": "clean_now"
          },
          "label": {
            "zh": "立即清空一次",
            "en": "Empty once"
          }
        },
        {
          "value": {
            "text": "start"
          },
          "label": {
            "zh": "启动自动清理",
            "en": "Schedule auto-clean"
          }
        }
      ],
      "default": {
        "text": "status"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "driveLetter",
      "label": {
        "zh": "目标盘符",
        "en": "Drive letter"
      },
      "description": {
        "zh": "可选；留空表示清理全部回收站。",
        "en": "Optional. Leave empty to clean every recycle bin."
      },
      "kind": "text",
      "placeholder": {
        "zh": "C",
        "en": "C"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "custom",
            "exportName": "drive_letter_format"
          }
        }
      ]
    },
    {
      "id": "interval",
      "label": {
        "zh": "清理间隔（秒）",
        "en": "Interval (seconds)"
      },
      "kind": "number",
      "range": {
        "min": 5,
        "step": 1
      },
      "default": {
        "number": 10
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "start"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerAtLeast",
            "minimum": 5
          }
        }
      ]
    },
    {
      "id": "maxCycles",
      "label": {
        "zh": "最大循环次数",
        "en": "Maximum cycles"
      },
      "description": {
        "zh": "设为 0 表示持续运行，直到手动取消。",
        "en": "Use 0 to keep running until cancelled."
      },
      "kind": "number",
      "range": {
        "min": 0,
        "step": 1
      },
      "default": {
        "number": 360
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "start"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerAtLeast",
            "minimum": 0
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "id": "scope",
      "title": {
        "zh": "清理控制",
        "en": "Cleanup controls"
      },
      "fieldIds": [
        "action",
        "driveLetter"
      ]
    },
    {
      "id": "schedule",
      "title": {
        "zh": "周期设置",
        "en": "Schedule"
      },
      "description": {
        "zh": "设为 0 表示持续运行，直到手动取消。",
        "en": "Use 0 to keep running until cancelled."
      },
      "fieldIds": [
        "interval",
        "maxCycles"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "driveLetter",
      "slot": "driveLetter",
      "transform": "trim"
    },
    {
      "fieldId": "interval",
      "slot": "interval",
      "transform": "asInteger"
    },
    {
      "fieldId": "maxCycles",
      "slot": "maxCycles",
      "transform": "asInteger"
    }
  ],
  "danger": {
    "type": "actionIn",
    "actionField": "action",
    "dangerous": [
      "clean_now",
      "start"
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认清空回收站？",
      "en": "Empty the recycle bin?"
    },
    "body": {
      "zh": "这会永久清空选定回收站，之后无法再从 Windows 恢复其中的文件。",
      "en": "This permanently empties the selected recycle bin. Windows cannot restore those files afterwards."
    },
    "confirmLabel": {
      "zh": "确认清理",
      "en": "Confirm cleanup"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "需要从工作区 UI 或 CLI 使用此节点的系统工作流时，可使用 Recycleu。"
      ],
      "en": [
        "Use Recycleu when you need this node's system workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 Recycleu，并在节点面板中运行。",
          "en": "Deploy Recycleu from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 Recycleu 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，查看结果与日志后再实际应用变更。"
          ],
          "en": [
            "Open the module registry and deploy Recycleu to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端中运行 Recycleu。",
          "en": "Run Recycleu directly from a terminal."
        },
        "cli": {
          "zh": [
            "当命令支持交互式提示时，运行 `xiranite recycleu` 进入引导模式。",
            "运行 `xiranite recycleu --help` 查看节点命令的具体标志与子命令。"
          ],
          "en": [
            "Run `xiranite recycleu` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite recycleu --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite recycleu",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属标志。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite recycleu",
            "description": {
              "zh": "启动节点的交互式终端工作流。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令标志",
              "en": "Command flags"
            },
            "command": "xiranite recycleu --help",
            "description": {
              "zh": "查看节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help recycleu",
            "description": {
              "zh": "在根 CLI 中渲染此共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "在实际运行前，先检查配置与受影响的系统状态。",
          "可用时优先使用预览模式。"
        ],
        "en": [
          "Review configuration and affected system state before running live actions.",
          "Prefer preview modes when available."
        ]
      }
    }
  }
}
