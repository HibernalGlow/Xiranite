            "allowed": [
              "match"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "required"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "match"
                ]
