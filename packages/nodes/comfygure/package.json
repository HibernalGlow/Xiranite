{
  "name": "@xiranite/node-comfygure",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Compile fixed Comfygure programs into validated local ComfyUI API prompt graphs.",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./core": { "types": "./dist/core.d.ts", "default": "./dist/core.js" },
    "./platform": { "types": "./dist/platform.d.ts", "default": "./dist/platform.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:tsc": "tsc -p tsconfig.json",
    "test": "vitest run src --passWithNoTests",
    "preflight:local": "bun src/live-preflight.ts",
    "audit:workflow": "bun src/workflow-audit.ts"
  },
  "dependencies": {
    "@xiranite/config": "workspace:*",
    "@xiranite/contract": "workspace:*",
    "fflate": "^0.8.3",
    "jsonrepair": "3.15.0",
    "write-file-atomic": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
