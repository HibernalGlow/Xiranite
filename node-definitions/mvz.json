{
  "definitionVersion": 1,
  "nodeId": "mvz",
  "title": {
    "zh": "MVZ",
    "en": "MVZ"
  },
  "description": {
    "zh": "根据 findz 输出，对归档内的文件执行删除、解压、移动或重命名。",
    "en": "Delete, extract, move, or rename files inside archives from findz output."
  },
  "actions": [
    {
      "id": "extract",
      "label": {
        "zh": "⇩ 解压",
        "en": "⇩ Extract"
      },
      "helpKey": "action.extract"
    },
    {
      "id": "move",
      "label": {
        "zh": "⇄ 移动",
        "en": "⇄ Move"
      },
      "helpKey": "action.move"
    },
    {
      "id": "delete",
      "label": {
        "zh": "⌫ 删除",
        "en": "⌫ Delete"
      },
      "helpKey": "action.delete"
    },
    {
      "id": "rename",
      "label": {
        "zh": "✎ 重命名",
        "en": "✎ Rename"
      },
      "helpKey": "action.rename"
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "extract"
          },
          "label": {
            "zh": "⇩ 解压",
            "en": "⇩ Extract"
          }
        },
        {
          "value": {
            "text": "move"
          },
          "label": {
            "zh": "⇄ 移动",
            "en": "⇄ Move"
          }
        },
        {
          "value": {
            "text": "delete"
          },
          "label": {
            "zh": "⌫ 删除",
            "en": "⌫ Delete"
          }
        },
        {
          "value": {
            "text": "rename"
          },
          "label": {
            "zh": "✎ 重命名",
            "en": "✎ Rename"
          }
        }
      ],
      "default": {
        "text": "extract"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "fileText",
      "label": {
        "zh": "归档内部条目",
        "en": "Archive entries"
      },
      "kind": "multiline",
      "lines": 5,
      "placeholder": {
        "zh": "D:/archive.zip//internal/file.txt",
        "en": "D:/archive.zip//internal/file.txt"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
          }
        }
      ]
    },
    {
      "id": "output",
      "label": {
        "zh": "输出目录",
        "en": "Output directory"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract",
              "move"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "near",
      "label": {
        "zh": "就近输出",
        "en": "Near archive"
      },
