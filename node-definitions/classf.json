  "groups": [],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "delimited"
    },
    {
      "fieldId": "crashuSourcesText",
      "slot": "crashuSourcePaths",
      "transform": "delimited"
    },
    {
      "fieldId": "placementMode",
      "slot": "placementMode",
      "transform": "trim"
    },
    {
      "fieldId": "targetDir",
      "slot": "targetDir",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "transferMode",
      "slot": "transferMode",
      "transform": "trim"
    },
    {
      "fieldId": "alreadyEnabled",
      "slot": "alreadyEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "waitEnabled",
      "slot": "waitEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "delEnabled",
      "slot": "delEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "existingPolicy",
      "slot": "existingPolicy",
      "transform": "trim"
    },
    {
      "fieldId": "workItemMode",
      "slot": "workItemMode",
      "transform": "trim"
    },
    {
      "fieldId": "blacklistKeywordsText",
      "slot": "blacklistKeywords",
      "transform": "delimited"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    },
    {
      "fieldId": "sameaGroupAlreadyEnabled",
      "slot": "sameaGroupAlreadyEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "sameaGroupWaitEnabled",
      "slot": "sameaGroupWaitEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "sameaGroupDelEnabled",
      "slot": "sameaGroupDelEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "sameaGroupMinOccurrences",
      "slot": "sameaGroupMinOccurrences",
      "transform": "asInteger"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "classify"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认执行 ClassF 管道",
      "en": "Confirm ClassF pipeline"
    },
    "body": {
      "zh": "MigrateF 将按已确认计划对文件系统执行真实操作。",
      "en": "MigrateF will apply the reviewed filesystem transfer plan."
    },
    "confirmLabel": {
      "zh": "确认执行",
      "en": "Run pipeline"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false
}
