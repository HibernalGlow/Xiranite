{
  "definitionVersion": 1,
  "nodeId": "rawfilter",
  "title": {
    "zh": "Rawfilter",
    "en": "Rawfilter"
  },
  "description": {
    "zh": "将相似归档分组，并将重复/原始版本移至 trash 或 multi 目录。",
    "en": "Group similar archives and move duplicate/raw versions to trash or multi."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描分组",
        "en": "Scan groups"
      }
    },
    {
      "id": "plan",
      "label": {
        "zh": "◌ 生成计划",
        "en": "Generate plan"
      }
    },
    {
      "id": "execute",
      "label": {
        "zh": "↳ 执行整理",
        "en": "Execute"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "计划操作",
        "en": "Plan action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描分组",
            "en": "Scan groups"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "◌ 生成计划",
            "en": "Generate plan"
          }
        },
        {
          "value": {
            "text": "execute"
          },
          "label": {
            "zh": "↳ 执行整理",
            "en": "Execute"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "path",
      "label": {
        "zh": "归档目录",
        "en": "Archive directory"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
          }
        }
      ]
    },
    {
      "id": "minSimilarity",
      "label": {
        "zh": "相似度阈值",
        "en": "Similarity threshold"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      "default": {
        "number": 0.82
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "nameOnlyMode",
      "label": {
        "zh": "仅按名称分组",
        "en": "Name only"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "createShortcuts",
      "label": {
        "zh": "创建快捷方式",
        "en": "Create shortcuts"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "trashOnly",
      "label": {
        "zh": "全部移入回收区",
        "en": "Trash only"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "filter",
      "title": {
        "zh": "归档计划",
        "en": "Archive plan"
      },
      "fieldIds": [
        "action",
        "path",
        "minSimilarity",
        "nameOnlyMode",
        "createShortcuts",
        "trashOnly",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "path",
      "slot": "path",
      "transform": "identity"
    },
    {
      "fieldId": "nameOnlyMode",
      "slot": "nameOnlyMode",
      "transform": "asBoolean"
    },
    {
      "fieldId": "createShortcuts",
      "slot": "createShortcuts",
      "transform": "asBoolean"
    },
    {
      "fieldId": "trashOnly",
      "slot": "trashOnly",
      "transform": "asBoolean"
    },
    {
      "fieldId": "minSimilarity",
      "slot": "minSimilarity",
      "transform": "identity"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "execute"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认整理归档",
      "en": "Confirm archive cleanup"
    },
    "body": {
      "zh": "重复归档将移入 trash 或 multi。",
      "en": "Duplicate archives will move to trash or multi."
    },
    "confirmLabel": {
      "zh": "确认整理",
      "en": "Execute"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "需要从工作区 UI 或 CLI 使用此节点的文件工作流时，可使用 Rawfilter。"
      ],
      "en": [
        "Use Rawfilter when you need this node's file workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 Rawfilter，并在节点面板中运行。",
          "en": "Deploy Rawfilter from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 Rawfilter 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，查看结果与日志后再实际应用变更。"
          ],
          "en": [
            "Open the module registry and deploy Rawfilter to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端中运行 Rawfilter。",
          "en": "Run Rawfilter directly from a terminal."
        },
        "cli": {
          "zh": [
            "当命令支持交互式提示时，运行 `xiranite rawfilter` 进入引导模式。",
            "运行 `xiranite rawfilter --help` 查看节点命令的具体标志与子命令。"
          ],
          "en": [
            "Run `xiranite rawfilter` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite rawfilter --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite rawfilter",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属标志。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite rawfilter",
            "description": {
              "zh": "启动节点的交互式终端工作流。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令标志",
              "en": "Command flags"
            },
            "command": "xiranite rawfilter --help",
            "description": {
              "zh": "查看节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help rawfilter",
            "description": {
              "zh": "在根 CLI 中渲染此共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "修改文件前，优先使用预览或试运行模式。",
          "处理大型文件夹时，请保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
