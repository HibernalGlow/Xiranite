      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "files"
          },
          "label": {
            "zh": "压缩包文件",
            "en": "Archive files"
          }
        },
        {
          "value": {
            "text": "folders"
          },
          "label": {
            "zh": "已解压文件夹",
            "en": "Extracted folders"
          }
        },
        {
          "value": {
            "text": "mixed"
          },
          "label": {
            "zh": "压缩包 + 文件夹",
            "en": "Archives + folders"
          }
        }
