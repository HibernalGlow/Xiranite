      "kind": "select",
      "options": [
        {
          "value": {
            "text": "merge"
          },
          "label": {
            "zh": "合并",
            "en": "Merge"
          }
        },
        {
          "value": {
            "text": "skip"
          },
          "label": {
            "zh": "跳过",
            "en": "Skip"
          }
        }
      ],
      "default": {
        "text": "merge"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "workItemMode",
      "label": {
