{
  "definitionVersion": 1,
  "nodeId": "linku",
  "title": {
    "zh": "Linku",
    "en": "Linku"
  },
  "description": {
    "zh": "创建、移动、导入、还原、列出并恢复符号链接记录。",
    "en": "Create, move, import, restore, list, and recover symlink records."
  },
  "actions": [
    {
      "id": "info",
      "label": {
        "zh": "◉ 信息",
        "en": "◉ Info"
      }
    },
    {
      "id": "create",
      "label": {
        "zh": "⊕ 创建",
        "en": "⊕ Create"
      }
    },
    {
      "id": "move_link",
      "label": {
        "zh": "⇄ 移动回链",
        "en": "⇄ Move & link"
      }
    },
    {
      "id": "list",
      "label": {
        "zh": "▤ 列表",
        "en": "▤ List"
      }
    },
    {
      "id": "recover",
      "label": {
        "zh": "↻ 恢复",
        "en": "↻ Recover"
      }
    },
    {
      "id": "restore",
      "label": {
        "zh": "⟲ 还原",
        "en": "⟲ Restore"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "info"
          },
          "label": {
            "zh": "◉ 信息",
            "en": "◉ Info"
          }
        },
        {
          "value": {
            "text": "create"
          },
          "label": {
            "zh": "⊕ 创建",
            "en": "⊕ Create"
          }
        },
        {
          "value": {
            "text": "move_link"
          },
          "label": {
            "zh": "⇄ 移动回链",
            "en": "⇄ Move & link"
          }
        },
        {
          "value": {
            "text": "list"
          },
          "label": {
            "zh": "▤ 列表",
            "en": "▤ List"
          }
        },
        {
          "value": {
            "text": "recover"
          },
          "label": {
            "zh": "↻ 恢复",
            "en": "↻ Recover"
          }
        },
        {
          "value": {
            "text": "restore"
          },
          "label": {
            "zh": "⟲ 还原",
            "en": "⟲ Restore"
          }
        }
      ],
      "default": {
        "text": "info"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "path",
      "label": {
        "zh": "源路径 / 原链接",
        "en": "Source path / original link"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "list",
              "recover"
            ]
          },
          "negated": true
        }
      },
      "rules": [
        {
          "rule": {
            "type": "required"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "info",
                  "restore",
                  "create",
                  "move_link"
                ]
              },
              "negated": false
            }
          }
        },
        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "info",
                  "restore",
                  "create",
                  "move_link"
                ]
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "target",
      "label": {
        "zh": "目标路径",
        "en": "Target path"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "create",
              "move_link"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "required"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "create",
                  "move_link"
                ]
              },
              "negated": false
            }
          }
        },
        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "create",
                  "move_link"
                ]
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "configPath",
      "label": {
        "zh": "链接记录配置",
        "en": "Link records config"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "links",
      "title": {
        "zh": "链接拓扑",
        "en": "Link topology"
      },
      "fieldIds": [
        "action",
        "path",
        "target",
        "configPath"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "path",
      "slot": "path",
      "transform": "identity"
    },
    {
      "fieldId": "target",
      "slot": "target",
      "transform": "identity"
    },
    {
      "fieldId": "configPath",
      "slot": "configPath",
      "transform": "identity"
    }
  ],
  "danger": {
    "type": "actionIn",
    "actionField": "action",
    "dangerous": [
      "create",
      "move_link",
      "recover",
      "restore"
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认文件系统链接操作",
      "en": "Confirm filesystem link operation"
    },
    "body": {
      "zh": "此操作会创建链接，移动回链还会移动原路径。",
      "en": "This creates symlinks; move-link also moves the source path."
    },
    "confirmLabel": {
      "zh": "确认执行",
      "en": "Execute"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "dashboard": {
    "title": {
      "zh": "LinkU",
      "en": "LinkU"
    },
    "primary": {
      "type": "firstNonEmpty",
      "fieldIds": [
        "path",
        "configPath"
      ],
      "fallbackText": {
        "zh": "LinkU",
        "en": "LinkU"
      }
    },
    "secondary": {
      "type": "firstNonEmpty",
      "fieldIds": [
        "target",
        "action"
      ],
      "fallbackText": {
        "zh": "LinkU",
        "en": "LinkU"
      }
    },
    "metrics": []
  },
  "help": {
    "whenToUse": {
      "zh": [
        "当需要从工作区 UI 或 CLI 使用该节点的文件工作流时，使用 Linku。"
      ],
      "en": [
        "Use Linku when you need this node's file workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 Linku，并在节点面板上运行。",
          "en": "Deploy Linku from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 Linku 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "运行预览或主操作，查看结果与日志后再应用真实变更。"
          ],
          "en": [
            "Open the module registry and deploy Linku to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端运行 Linku。",
          "en": "Run Linku directly from a terminal."
        },
        "cli": {
          "zh": [
            "命令支持交互式提示时，运行 `xiranite linku` 进入引导模式。",
            "运行 `xiranite linku --help` 查看该节点命令的完整参数与子命令。"
          ],
          "en": [
            "Run `xiranite linku` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite linku --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite linku",
        "description": {
          "zh": "打开节点 CLI，或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite linku",
            "description": {
              "zh": "启动该节点的交互式终端工作流。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite linku --help",
            "description": {
              "zh": "显示节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "导入旧记录",
              "en": "Import legacy records"
            },
            "command": "xiranite linku import --path C:\\path\\to\\linku.toml",
            "description": {
              "zh": "只导入当前链接和目标均有效的记录；添加 --includeInvalid 可保留失效历史记录。",
              "en": "Import only records whose current link and target are valid. Add --includeInvalid to retain invalid historical records."
            }
          },
          {
            "label": {
              "zh": "还原已记录链接",
              "en": "Restore a recorded link"
            },
            "command": "xiranite linku restore --path C:\\path\\to\\original",
            "description": {
              "zh": "校验当前链接后将目标移回原路径，并删除对应记录。",
              "en": "Validate the live link, move its target back to the original path, then remove the record."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help linku",
            "description": {
              "zh": "在根 CLI 中渲染这条共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "修改文件前优先使用预览或 dry-run 模式。",
          "处理大文件夹时保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
