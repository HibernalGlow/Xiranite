{
  "definitionVersion": 1,
  "nodeId": "encodeb",
  "title": {
    "zh": "Encodeb",
    "en": "Encodeb"
  },
  "description": {
    "zh": "通过重新解码路径组件，预览并修复乱码文件名。",
    "en": "Preview and recover garbled filenames by re-decoding path components."
  },
  "actions": [
    {
      "id": "find",
      "label": {
        "zh": "⌕ 查找乱码",
        "en": "Find"
      }
    },
    {
      "id": "preview",
      "label": {
        "zh": "◉ 预览修复",
        "en": "Preview"
      }
    },
    {
      "id": "recover",
      "label": {
        "zh": "↻ 执行修复",
        "en": "Recover"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "修复任务",
        "en": "Recovery task"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "find"
          },
          "label": {
            "zh": "⌕ 查找乱码",
            "en": "Find"
          }
        },
        {
          "value": {
            "text": "preview"
          },
          "label": {
            "zh": "◉ 预览修复",
            "en": "Preview"
          }
        },
        {
          "value": {
            "text": "recover"
          },
          "label": {
            "zh": "↻ 执行修复",
            "en": "Recover"
          }
        }
      ],
      "default": {
        "text": "preview"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "paths",
      "label": {
        "zh": "输入路径",
        "en": "Input paths"
      },
      "kind": "path-list",
      "lines": 6,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "preset",
      "label": {
        "zh": "修复预设",
        "en": "Repair preset"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "auto"
          },
          "label": {
            "zh": "Auto · 自动判断（推荐）",
            "en": "Auto detect (recommended)"
          }
        },
        {
          "value": {
            "text": "cn"
          },
          "label": {
            "zh": "CN · ╓╨╬─ → 中文",
            "en": "CN · ╓╨╬─ → 中文"
          }
        },
        {
          "value": {
            "text": "jp"
          },
          "label": {
            "zh": "JP · âeâXâg → テスト",
            "en": "JP · âeâXâg → テスト"
          }
        },
        {
          "value": {
            "text": "kr"
          },
          "label": {
            "zh": "KR · ╟╤▒█ → 한글",
            "en": "KR · ╟╤▒█ → 한글"
          }
        },
        {
          "value": {
            "text": "jp_from_cn"
          },
          "label": {
            "zh": "JP · 僥僗僩 → テスト",
            "en": "JP · 僥僗僩 → テスト"
          }
        },
        {
          "value": {
            "text": "jp_iso2022_from_cn"
          },
          "label": {
            "zh": "JP · CP936 → ISO-2022-JP",
            "en": "JP · CP936 → ISO-2022-JP"
          }
        },
        {
          "value": {
            "text": "latin1_utf8"
          },
          "label": {
            "zh": "Mojibake · ã‚» → セ",
            "en": "Mojibake · ã‚» → セ"
          }
        },
        {
          "value": {
            "text": "hash_u"
          },
          "label": {
            "zh": "#U30BB → セ",
            "en": "#U30BB → セ"
          }
        },
        {
          "value": {
            "text": "middle_dot"
          },
          "label": {
            "zh": "魔法・少女 → 魔法·少女",
            "en": "魔法・少女 → 魔法·少女"
          }
        },
        {
          "value": {
            "text": "custom"
          },
          "label": {
            "zh": "自定义",
            "en": "Custom"
          }
        }
      ],
      "default": {
        "text": "auto"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "srcEncoding",
      "label": {
        "zh": "源编码",
        "en": "Source encoding"
      },
      "kind": "text",
      "default": {
        "text": "auto"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dstEncoding",
      "label": {
        "zh": "目标编码",
        "en": "Target encoding"
      },
      "kind": "text",
      "default": {
        "text": "auto"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "strategy",
      "label": {
        "zh": "修复策略",
        "en": "Strategy"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "replace"
          },
          "label": {
            "zh": "原地替换",
            "en": "Replace"
          }
        },
        {
          "value": {
            "text": "copy"
          },
          "label": {
            "zh": "复制修复副本",
            "en": "Copy"
          }
        }
      ],
      "default": {
        "text": "replace"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "recover"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "limit",
      "label": {
        "zh": "候选上限",
        "en": "Candidate limit"
      },
      "kind": "number",
      "range": {
        "min": 1,
        "max": 2000,
        "step": 1
      },
      "default": {
        "number": 200
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "repair",
      "title": {
        "zh": "编码修复",
        "en": "Encoding repair"
      },
      "fieldIds": [
        "action",
        "paths",
        "preset",
        "srcEncoding",
        "dstEncoding",
        "strategy",
        "limit"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "paths",
      "slot": "paths",
      "transform": "lines"
    },
    {
      "fieldId": "preset",
      "slot": "preset",
      "transform": "trim"
    },
    {
      "fieldId": "srcEncoding",
      "slot": "srcEncoding",
      "transform": "identity",
      "defaultExport": "effective_src_encoding"
    },
    {
      "fieldId": "dstEncoding",
      "slot": "dstEncoding",
      "transform": "identity",
      "defaultExport": "effective_dst_encoding"
    },
    {
      "fieldId": "preset",
      "slot": "transform",
      "transform": "identity",
      "defaultExport": "preset_transform"
    },
    {
      "fieldId": "strategy",
      "slot": "strategy",
      "transform": "trim"
    },
    {
      "fieldId": "limit",
      "slot": "limit",
      "transform": "asInteger"
    }
  ],
  "danger": {
    "type": "actionIn",
    "actionField": "action",
    "dangerous": [
      "recover"
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认文件名修复",
      "en": "Confirm filename recovery"
    },
    "body": {
      "zh": "将按当前编码和策略改动真实文件路径。",
      "en": "Real file paths will be changed."
    },
    "confirmLabel": {
      "zh": "确认修复",
      "en": "Recover"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "需要在工作区 UI 或 CLI 中使用该节点的文件工作流时，使用 Encodeb。"
      ],
      "en": [
        "Use Encodeb when you need this node's file workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 Encodeb，并在节点面板上运行。",
          "en": "Deploy Encodeb from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 Encodeb 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，再检查结果与日志，最后才应用真实变更。"
          ],
          "en": [
            "Open the module registry and deploy Encodeb to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接从终端运行 Encodeb。",
          "en": "Run Encodeb directly from a terminal."
        },
        "cli": {
          "zh": [
            "命令支持交互提示时，运行 `xiranite encodeb` 进入引导模式。",
            "运行 `xiranite encodeb --help` 查看该节点命令的具体参数与子命令。"
          ],
          "en": [
            "Run `xiranite encodeb` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite encodeb --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite encodeb",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite encodeb",
            "description": {
              "zh": "启动该节点的交互式终端流程。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite encodeb --help",
            "description": {
              "zh": "显示该节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help encodeb",
            "description": {
              "zh": "在根 CLI 中渲染该共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "在修改文件前，优先使用预览或 dry-run 模式。",
          "处理大文件夹时请保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
