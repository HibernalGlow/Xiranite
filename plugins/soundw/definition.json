{
  "definitionVersion": 1,
  "nodeId": "soundw",
  "title": {
    "zh": "SoundW",
    "en": "SoundW"
  },
  "description": {
    "zh": "通过 SoundSwitch 快速查看、切换和静音录音设备。",
    "en": "Inspect, switch, and mute recording devices through SoundSwitch."
  },
  "actions": [
    {
      "id": "status",
      "label": {
        "zh": "当前状态",
        "en": "Current status"
      }
    },
    {
      "id": "switch-recording",
      "label": {
        "zh": "切换录音设备",
        "en": "Switch recording"
      }
    },
    {
      "id": "mute",
      "label": {
        "zh": "静音麦克风",
        "en": "Mute microphone"
      }
    },
    {
      "id": "unmute",
      "label": {
        "zh": "解除静音",
        "en": "Unmute microphone"
      }
    },
    {
      "id": "toggle-mute",
      "label": {
        "zh": "切换静音",
        "en": "Toggle mute"
      }
    },
    {
      "id": "profiles",
      "label": {
        "zh": "扫描预设",
        "en": "Scan profiles"
      }
    },
    {
      "id": "profile",
      "label": {
        "zh": "激活预设",
        "en": "Activate profile"
      }
    },
    {
      "id": "settings",
      "label": {
        "zh": "打开设置",
        "en": "Open settings"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "status"
          },
          "label": {
            "zh": "当前状态",
            "en": "Current status"
          }
        },
        {
          "value": {
            "text": "switch-recording"
          },
          "label": {
            "zh": "切换录音设备",
            "en": "Switch recording"
          }
        },
        {
          "value": {
            "text": "mute"
          },
          "label": {
            "zh": "静音麦克风",
            "en": "Mute microphone"
          }
        },
        {
          "value": {
            "text": "unmute"
          },
          "label": {
            "zh": "解除静音",
            "en": "Unmute microphone"
          }
        },
        {
          "value": {
            "text": "toggle-mute"
          },
          "label": {
            "zh": "切换静音",
            "en": "Toggle mute"
          }
        },
        {
          "value": {
            "text": "profiles"
          },
          "label": {
            "zh": "扫描预设",
            "en": "Scan profiles"
          }
        },
        {
          "value": {
            "text": "profile"
          },
          "label": {
            "zh": "激活预设",
            "en": "Activate profile"
          }
        },
        {
          "value": {
            "text": "settings"
          },
          "label": {
            "zh": "打开设置",
            "en": "Open settings"
          }
        }
      ],
      "default": {
        "text": "status"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "profileName",
      "label": {
        "zh": "预设名称",
        "en": "Profile name"
      },
      "kind": "text",
      "placeholder": {
        "zh": "输入或从扫描结果选择",
        "en": "Type or select a scanned profile"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "profile"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "profile"
                ]
              },
              "negated": false
            }
          },
          "message": {
            "zh": "请输入预设名称。",
            "en": "Enter a profile name."
          }
        }
      ]
    },
    {
      "id": "soundSwitchPath",
      "label": {
        "zh": "CLI 路径覆盖",
        "en": "CLI path override"
      },
      "kind": "text",
      "placeholder": {
        "zh": "SoundSwitch.CLI.exe",
        "en": "SoundSwitch.CLI.exe"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "profileName",
      "slot": "profileName",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "soundSwitchPath",
      "slot": "soundSwitchPath",
      "transform": "trimOrOmit"
    }
  ],
  "danger": {
    "type": "none"
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "需要快速切换录音设备、应用预设或切换麦克风静音状态时使用。"
      ],
      "en": [
        "需要快速切换录音设备、应用预设或切换麦克风静音状态时使用。"
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "TUI / GUI",
          "en": "TUI / GUI"
        },
        "summary": {
          "zh": "扫描并选择预设，或直接执行麦克风动作。",
          "en": "扫描并选择预设，或直接执行麦克风动作。"
        },
        "ui": {
          "zh": [
            "确认 SoundSwitch.CLI 路径。",
            "扫描或输入预设名称。",
            "执行切换、静音或状态查询并查看命令日志。"
          ],
          "en": [
            "确认 SoundSwitch.CLI 路径。",
            "扫描或输入预设名称。",
            "执行切换、静音或状态查询并查看命令日志。"
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "适合快捷键、脚本和终端操作。",
          "en": "适合快捷键、脚本和终端操作。"
        },
        "cli": {
          "zh": [
            "运行 `xsoundw ui` 打开工作台。",
            "运行 `xsoundw gd` 使用引导模式。",
            "运行 `xsoundw --help` 查看全部动作。"
          ],
          "en": [
            "运行 `xsoundw ui` 打开工作台。",
            "运行 `xsoundw gd` 使用引导模式。",
            "运行 `xsoundw --help` 查看全部动作。"
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "SoundW CLI",
          "en": "SoundW CLI"
        },
        "command": "xsoundw",
        "description": {
          "zh": "打开默认交互模式。",
          "en": "打开默认交互模式。"
        },
        "examples": [
          {
            "command": "xsoundw ui"
          },
          {
            "command": "xsoundw gd"
          },
          {
            "command": "xsoundw status --json"
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "guided",
      "notes": {
        "zh": [
          "设备切换会影响系统当前录音输入。",
          "状态查询不会修改设备。"
        ],
        "en": [
          "设备切换会影响系统当前录音输入。",
          "状态查询不会修改设备。"
        ]
      }
    }
  }
}
