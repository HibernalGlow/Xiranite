{
  "definitionVersion": 1,
  "nodeId": "owithu",
  "title": {
    "zh": "Owithu",
    "en": "Owithu"
  },
  "description": {
    "zh": "预览、注册和注销 Windows Open-with 右键菜单项（基于 TOML 配置）。",
    "en": "Preview, register, and unregister Windows Open-with context menu entries from TOML."
  },
  "actions": [
    {
      "id": "preview",
      "label": {
        "zh": "◉ 预览",
        "en": "◉ Preview"
      }
    },
    {
      "id": "register",
      "label": {
        "zh": "⊕ 注册",
        "en": "⊕ Register"
      }
    },
    {
      "id": "unregister",
      "label": {
        "zh": "⊖ 注销",
        "en": "⊖ Unregister"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "preview"
          },
          "label": {
            "zh": "◉ 预览",
            "en": "◉ Preview"
          }
        },
        {
          "value": {
            "text": "register"
          },
          "label": {
            "zh": "⊕ 注册",
            "en": "⊕ Register"
          }
        },
        {
          "value": {
            "text": "unregister"
          },
          "label": {
            "zh": "⊖ 注销",
            "en": "⊖ Unregister"
          }
        }
      ],
      "default": {
        "text": "preview"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "path",
      "label": {
        "zh": "配置文件",
        "en": "Config file"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "anyFilled",
            "fieldIds": [
              "path",
              "configText"
            ]
          },
          "message": {
            "zh": "请输入配置路径或粘贴 TOML。",
            "en": "Enter a config path or TOML."
          }
        }
      ]
    },
    {
      "id": "configText",
      "label": {
        "zh": "TOML 内容",
        "en": "TOML content"
      },
      "kind": "multiline",
      "lines": 5,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "hive",
      "label": {
        "zh": "Registry Hive",
        "en": "Registry Hive"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": ""
          },
          "label": {
            "zh": "配置默认",
            "en": "Config default"
          }
        },
        {
          "value": {
            "text": "HKCU"
          },
          "label": {
            "zh": "HKCU",
            "en": "HKCU"
          }
        },
        {
          "value": {
            "text": "HKCR"
          },
          "label": {
            "zh": "HKCR",
            "en": "HKCR"
          }
        },
        {
          "value": {
            "text": "HKLM"
          },
          "label": {
            "zh": "HKLM",
            "en": "HKLM"
          }
        }
      ],
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "onlyKey",
      "label": {
        "zh": "仅处理条目",
        "en": "Only entry key"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "registry",
      "title": {
        "zh": "注册表拓扑",
        "en": "Registry topology"
      },
      "fieldIds": [
        "action",
        "path",
        "configText",
        "hive",
        "onlyKey"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "path",
      "slot": "path",
      "transform": "identity"
    },
    {
      "fieldId": "configText",
      "slot": "configText",
      "transform": "identity"
    },
    {
      "fieldId": "hive",
      "slot": "hive",
      "transform": "trim"
    },
    {
      "fieldId": "onlyKey",
      "slot": "onlyKey",
      "transform": "identity"
    }
  ],
  "danger": {
    "type": "actionIn",
    "actionField": "action",
    "dangerous": [
      "register",
      "unregister"
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认写入注册表",
      "en": "Confirm registry write"
    },
    "body": {
      "zh": "此操作会修改 Windows 右键菜单注册表。",
      "en": "This changes Windows context-menu registry keys."
    },
    "confirmLabel": {
      "zh": "确认注册",
      "en": "Register"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "需要从工作区 UI 或 CLI 使用此节点的系统工作流时，可使用 Owithu。"
      ],
      "en": [
        "Use Owithu when you need this node's system workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 Owithu，并在节点面板中运行。",
          "en": "Deploy Owithu from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 Owithu 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，查看结果与日志后再实际应用变更。"
          ],
          "en": [
            "Open the module registry and deploy Owithu to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端中运行 Owithu。",
          "en": "Run Owithu directly from a terminal."
        },
        "cli": {
          "zh": [
            "当命令支持交互式提示时，运行 `xiranite owithu` 进入引导模式。",
            "运行 `xiranite owithu --help` 查看节点命令的具体标志与子命令。"
          ],
          "en": [
            "Run `xiranite owithu` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite owithu --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite owithu",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属标志。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite owithu",
            "description": {
              "zh": "启动节点的交互式终端工作流。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令标志",
              "en": "Command flags"
            },
            "command": "xiranite owithu --help",
            "description": {
              "zh": "查看节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help owithu",
            "description": {
              "zh": "在根 CLI 中渲染此共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "在实际运行前，先检查配置与受影响的系统状态。",
          "可用时优先使用预览模式。"
        ],
        "en": [
          "Review configuration and affected system state before running live actions.",
          "Prefer preview modes when available."
        ]
      }
    }
  }
}
