      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract",
              "move"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "flatten",
      "label": {
        "zh": "扁平提取",
        "en": "Flatten"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract",
              "move"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "pattern",
      "label": {
        "zh": "匹配表达式",
        "en": "Rename pattern"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "rename"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
