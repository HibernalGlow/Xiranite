{
  "definitionVersion": 1,
  "nodeId": "envuconfig",
  "title": {
    "zh": "EnvU Config",
    "en": "EnvU Config"
  },
  "description": {
    "zh": "盘点、记录并备份 EnvU 安装配置文件。",
    "en": "Inventory, record, and back up EnvU installation configuration files."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描",
        "en": "⌕ Scan"
      }
    },
    {
      "id": "manifest",
      "label": {
        "zh": "▤ 清单",
        "en": "▤ Manifest"
      }
    },
    {
      "id": "backup",
      "label": {
        "zh": "⇄ 备份",
        "en": "⇄ Backup"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描",
            "en": "⌕ Scan"
          }
        },
        {
          "value": {
            "text": "manifest"
          },
          "label": {
            "zh": "▤ 清单",
            "en": "▤ Manifest"
          }
        },
        {
          "value": {
            "text": "backup"
          },
          "label": {
            "zh": "⇄ 备份",
            "en": "⇄ Backup"
          }
        }
      ],
      "default": {
        "text": "scan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "root",
      "label": {
        "zh": "EnvU 根目录",
        "en": "EnvU root"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "required"
          }
        },
        {
          "rule": {
            "type": "nonBlank"
          }
        }
      ]
    },
    {
      "id": "includeText",
      "label": {
        "zh": "包含规则",
        "en": "Include rules"
      },
      "kind": "multiline",
      "lines": 5,
      "default": {
        "text": "config/\ndotfile/\nsrc/linku/*.toml\nsrc/owithu/*.toml\nsrc/reinstallp/*.toml\n*.toml\n*.md\noutput_paths.txt"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "backup"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "backupDir",
      "label": {
        "zh": "备份目录",
        "en": "Backup directory"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": true
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "all",
            "predicates": [
              {
                "test": {
                  "type": "actionIs",
                  "actionField": "action",
                  "allowed": [
                    "backup"
                  ]
                },
                "negated": false
              },
              {
                "test": {
                  "type": "fieldTrue",
                  "fieldId": "dryRun"
                },
                "negated": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": "manifestName",
      "label": {
        "zh": "清单文件名",
        "en": "Manifest name"
      },
      "kind": "text",
      "default": {
        "text": "envu-config-manifest.json"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": true
        }
      },
      "rules": []
    },
    {
      "id": "databasePath",
      "label": {
        "zh": "运行记录数据库",
        "en": "Run database"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "recordRun",
      "label": {
        "zh": "记录运行",
        "en": "Record run"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "ledger",
      "title": {
        "zh": "配置账本",
        "en": "Configuration ledger"
      },
      "fieldIds": [
        "action",
        "root",
        "includeText",
        "backupDir",
        "manifestName",
        "databasePath",
        "recordRun",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "root",
      "slot": "root",
      "transform": "identity"
    },
    {
      "fieldId": "includeText",
      "slot": "include",
      "transform": "lines"
    },
    {
      "fieldId": "backupDir",
      "slot": "backupDir",
      "transform": "identity"
    },
    {
      "fieldId": "manifestName",
      "slot": "manifestName",
      "transform": "identity"
    },
    {
      "fieldId": "databasePath",
      "slot": "databasePath",
      "transform": "identity"
    },
    {
      "fieldId": "recordRun",
      "slot": "recordRun",
      "transform": "asBoolean",
      "defaultExport": "default_record_run"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "backup"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认执行配置备份",
      "en": "Confirm configuration backup"
    },
    "body": {
      "zh": "{root} → {backupDir}",
      "en": "{root} → {backupDir}"
    },
    "confirmLabel": {
      "zh": "确认备份",
      "en": "Backup"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "dashboard": {
    "title": {
      "zh": "EnvU Config",
      "en": "EnvU Config"
    },
    "primary": {
      "type": "firstNonEmpty",
      "fieldIds": [
        "root"
      ],
      "fallbackText": {
        "zh": "EnvU",
        "en": "EnvU"
      }
    },
    "secondary": {
      "type": "firstNonEmpty",
      "fieldIds": [
        "backupDir",
        "action"
      ],
      "fallbackText": {
        "zh": "EnvU Config",
        "en": "EnvU Config"
      }
    },
    "metrics": []
  },
  "help": {
    "whenToUse": {
      "zh": [
        "需要在工作区 UI 或 CLI 中使用该节点的系统工作流时，使用 EnvU Config。"
      ],
      "en": [
        "Use EnvU Config when you need this node's system workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 EnvU Config，并在节点面板上运行。",
          "en": "Deploy EnvU Config from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 EnvU Config 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，再检查结果与日志，最后才应用真实变更。"
          ],
          "en": [
            "Open the module registry and deploy EnvU Config to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接从终端运行 EnvU Config。",
          "en": "Run EnvU Config directly from a terminal."
        },
        "cli": {
          "zh": [
            "命令支持交互提示时，运行 `xiranite envuconfig` 进入引导模式。",
            "运行 `xiranite envuconfig --help` 查看该节点命令的具体参数与子命令。"
          ],
          "en": [
            "Run `xiranite envuconfig` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite envuconfig --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite envuconfig",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite envuconfig",
            "description": {
              "zh": "启动该节点的交互式终端流程。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite envuconfig --help",
            "description": {
              "zh": "显示该节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help envuconfig",
            "description": {
              "zh": "在根 CLI 中渲染该共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "执行真实操作前，请先核对配置与受影响的系统状态。",
          "可用时优先使用预览模式。"
        ],
        "en": [
          "Review configuration and affected system state before running live actions.",
          "Prefer preview modes when available."
        ]
      }
    }
  }
}
