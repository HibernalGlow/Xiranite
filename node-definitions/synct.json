{
  "definitionVersion": 1,
  "nodeId": "synct",
  "title": {
    "zh": "Synct",
    "en": "Synct"
  },
  "description": {
    "zh": "将文件或文件夹归档到按日期组织的路径。",
    "en": "Archive files or folders into date-based paths."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描",
        "en": "⌕ Scan"
      }
    },
    {
      "id": "plan",
      "label": {
        "zh": "⌁ 规划",
        "en": "⌁ Plan"
      }
    },
    {
      "id": "archive",
      "label": {
        "zh": "⇄ 归档",
        "en": "⇄ Archive"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描",
            "en": "⌕ Scan"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌁ 规划",
            "en": "⌁ Plan"
          }
        },
        {
          "value": {
            "text": "archive"
          },
          "label": {
            "zh": "⇄ 归档",
            "en": "⇄ Archive"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "来源路径",
        "en": "Source paths"
      },
      "kind": "path-list",
      "lines": 3,
      "placeholder": {
        "zh": "每行一个文件或目录",
        "en": "One file or folder per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          },
          "message": {
            "zh": "请至少输入一个来源路径。",
            "en": "Enter at least one source path."
          }
        }
      ]
    },
    {
      "id": "sourceMode",
      "label": {
        "zh": "来源类型",
        "en": "Source mode"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "files"
          },
          "label": {
            "zh": "▤ 文件",
            "en": "▤ Files"
          }
        },
        {
          "value": {
            "text": "folders"
          },
          "label": {
            "zh": "▣ 文件夹",
            "en": "▣ Folders"
          }
        }
      ],
      "default": {
        "text": "files"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "formatKey",
      "label": {
        "zh": "归档路径格式",
        "en": "Archive format"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "year"
          },
          "label": {
            "zh": "YYYY",
            "en": "YYYY"
          }
        },
        {
          "value": {
            "text": "year_month"
          },
          "label": {
            "zh": "YYYY-MM",
            "en": "YYYY-MM"
          }
        },
        {
          "value": {
            "text": "year_month_day"
          },
          "label": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          }
        },
        {
          "value": {
            "text": "month_day"
          },
          "label": {
            "zh": "MM-DD",
            "en": "MM-DD"
          }
        },
        {
          "value": {
            "text": "day"
          },
          "label": {
            "zh": "DD",
            "en": "DD"
          }
        },
        {
          "value": {
            "text": "nested_y_m"
          },
          "label": {
            "zh": "YYYY / MM",
            "en": "YYYY / MM"
          }
        },
        {
          "value": {
            "text": "nested_y_m_d"
          },
          "label": {
            "zh": "YYYY / MM / DD",
            "en": "YYYY / MM / DD"
          }
        },
        {
          "value": {
            "text": "nested_ym_d"
          },
          "label": {
            "zh": "YYYY-MM / DD",
            "en": "YYYY-MM / DD"
          }
        },
        {
          "value": {
            "text": "nested_y_md"
          },
          "label": {
            "zh": "YYYY / MM-DD",
            "en": "YYYY / MM-DD"
          }
        }
      ],
      "default": {
        "text": "year_month"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "recursive",
      "label": {
        "zh": "递归扫描",
        "en": "Recursive"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "archiveFolder",
      "label": {
        "zh": "使用 archive 子目录",
        "en": "Use archive folder"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "fallbackToCreatedTime",
      "label": {
        "zh": "回退到创建时间",
        "en": "Fallback to created time"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "syncFolderFileTimes",
      "label": {
        "zh": "同步文件夹内时间",
        "en": "Sync folder file times"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "fieldEquals",
            "fieldId": "sourceMode",
            "value": {
              "text": "folders"
            }
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预览",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "archive"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "sources",
      "title": {
        "zh": "来源与归档规则",
        "en": "Sources and archive rules"
      },
      "fieldIds": [
        "action",
        "pathsText",
        "sourceMode",
        "formatKey",
        "recursive",
        "archiveFolder",
        "fallbackToCreatedTime",
        "syncFolderFileTimes",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "lines"
    },
    {
      "fieldId": "sourceMode",
      "slot": "sourceMode",
      "transform": "trim"
    },
    {
      "fieldId": "formatKey",
      "slot": "formatKey",
      "transform": "trim"
    },
    {
      "fieldId": "recursive",
      "slot": "recursive",
      "transform": "asBoolean"
    },
    {
      "fieldId": "archiveFolder",
      "slot": "archiveFolder",
      "transform": "asBoolean"
    },
    {
      "fieldId": "fallbackToCreatedTime",
      "slot": "fallbackToCreatedTime",
      "transform": "asBoolean"
    },
    {
      "fieldId": "syncFolderFileTimes",
      "slot": "syncFolderFileTimes",
      "transform": "asBoolean"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "archive"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认移动归档项目",
      "en": "Confirm archive moves"
    },
    "body": {
      "zh": "就绪项目将被移动到按日期生成的目录。",
      "en": "Ready items will be moved into date-based directories."
    },
    "confirmLabel": {
      "zh": "确认归档",
      "en": "Archive"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "dashboard": {
    "title": {
      "zh": "Synct",
      "en": "Synct"
    },
    "primary": {
      "type": "firstNonEmpty",
      "fieldIds": [
        "pathsText"
      ],
      "fallbackText": {
        "zh": "Synct",
        "en": "Synct"
      }
    },
    "secondary": {
      "type": "field",
      "fieldId": "formatKey"
    },
    "metrics": []
  }
}
