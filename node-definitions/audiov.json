{
  "definitionVersion": 1,
  "nodeId": "audiov",
  "title": {
    "zh": "AudioV",
    "en": "AudioV"
  },
  "description": {
    "zh": "通过原生 ffmpeg 工作流从视频文件中提取音轨。",
    "en": "Extract audio tracks from video files with the native ffmpeg workflow."
  },
  "actions": [
    {
      "id": "status",
      "label": {
        "zh": "◌ 检查 ffmpeg",
        "en": "Check ffmpeg"
      }
    },
    {
      "id": "plan",
      "label": {
        "zh": "⌕ 预演命令",
        "en": "Plan commands"
      }
    },
    {
      "id": "run",
      "label": {
        "zh": "▶ 提取音轨",
        "en": "Extract audio"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "提取操作",
        "en": "Extraction action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "status"
          },
          "label": {
            "zh": "◌ 检查 ffmpeg",
            "en": "Check ffmpeg"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌕ 预演命令",
            "en": "Plan commands"
          }
        },
        {
          "value": {
            "text": "run"
          },
          "label": {
            "zh": "▶ 提取音轨",
            "en": "Extract audio"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "paths",
      "label": {
        "zh": "视频队列",
        "en": "Video queue"
      },
      "kind": "path-list",
      "lines": 6,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "status"
                ]
              },
              "negated": true
            }
          }
        }
      ]
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "status"
            ]
          },
          "negated": true
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "audio",
      "title": {
        "zh": "音轨提取",
        "en": "Audio extraction"
      },
      "fieldIds": [
        "action",
        "paths",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "paths",
      "slot": "paths",
      "transform": "delimited"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean",
      "defaultExport": "default_dry_run"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "run"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认提取音轨",
      "en": "Confirm audio extraction"
    },
    "body": {
      "zh": "ffmpeg 将写入每个视频对应的 .audio.m4a 文件。",
      "en": "ffmpeg will write one .audio.m4a file for each video."
    },
    "confirmLabel": {
      "zh": "开始提取",
      "en": "Extract"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": true,
  "help": {
    "whenToUse": {
      "zh": [
        "需要从工作区 UI 或 CLI 使用本节点的视频处理流程时使用 AudioV。"
      ],
      "en": [
        "Use AudioV when you need this node's video workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 AudioV，并在节点面板上运行。",
          "en": "Deploy AudioV from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 AudioV 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，查看结果与日志后再应用真实变更。"
          ],
          "en": [
            "Open the module registry and deploy AudioV to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端运行 AudioV。",
          "en": "Run AudioV directly from a terminal."
        },
        "cli": {
          "zh": [
            "运行 `xiranite audiov` 进入引导模式（当命令支持交互式提示时）。",
            "运行 `xiranite audiov --help` 查看该节点命令的具体参数与子命令。"
          ],
          "en": [
            "Run `xiranite audiov` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite audiov --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite audiov",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite audiov",
            "description": {
              "zh": "启动该节点的交互式终端流程。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite audiov --help",
            "description": {
              "zh": "查看该节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help audiov",
            "description": {
              "zh": "在根 CLI 中渲染本条共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "改动文件前优先使用预览或 dry-run 模式。",
          "处理大型文件夹时请保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
