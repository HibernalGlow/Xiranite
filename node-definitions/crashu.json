{
  "definitionVersion": 1,
  "nodeId": "crashu",
  "title": {
    "zh": "Crashu",
    "en": "Crashu"
  },
  "description": {
    "zh": "匹配相似文件夹名称，并可选地移动匹配到的文件夹。",
    "en": "Match similar folder names and optionally move matched folders."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描",
        "en": "⌕ Scan"
      },
      "helpKey": "action.scan"
    },
    {
      "id": "plan",
      "label": {
        "zh": "⌁ 规划",
        "en": "⌁ Plan"
      },
      "helpKey": "action.plan"
    },
    {
      "id": "move",
      "label": {
        "zh": "⇄ 移动",
        "en": "⇄ Move"
      },
      "helpKey": "action.move"
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描",
            "en": "⌕ Scan"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌁ 规划",
            "en": "⌁ Plan"
          }
        },
        {
          "value": {
            "text": "move"
          },
          "label": {
            "zh": "⇄ 移动",
            "en": "⇄ Move"
          }
        }
      ],
      "default": {
        "text": "scan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "sourcePaths",
      "label": {
        "zh": "来源目录",
        "en": "Source directories"
      },
      "kind": "path-list",
      "lines": 3,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "targetPath",
      "label": {
        "zh": "目标目录",
        "en": "Target directory"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "custom",
            "exportName": "target_dir_or_names_required"
          }
        }
      ]
    },
    {
      "id": "targetNames",
      "label": {
        "zh": "目标名称（可选）",
        "en": "Target names"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "destinationPath",
      "label": {
        "zh": "移动目标根目录",
        "en": "Move destination"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "similarityThreshold",
      "label": {
        "zh": "相似度阈值",
        "en": "Similarity threshold"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.05
      },
      "default": {
        "number": 0.65
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "moveDirection",
      "label": {
        "zh": "移动方向",
        "en": "Move direction"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "to_target"
          },
          "label": {
            "zh": "来源 → 目标",
            "en": "Source → target"
          }
        },
        {
          "value": {
            "text": "to_source"
          },
          "label": {
            "zh": "目标 → 来源",
            "en": "Target → source"
          }
        }
      ],
      "default": {
        "text": "to_target"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "conflictPolicy",
      "label": {
        "zh": "冲突策略",
        "en": "Conflict policy"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "skip"
          },
          "label": {
            "zh": "跳过",
            "en": "Skip"
          }
        },
        {
          "value": {
            "text": "rename"
          },
          "label": {
            "zh": "改名",
            "en": "Rename"
          }
        },
        {
          "value": {
            "text": "overwrite"
          },
          "label": {
            "zh": "覆盖",
            "en": "Overwrite"
          }
        }
      ],
      "default": {
        "text": "skip"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "pairsFileName",
      "label": {
        "zh": "配对记录文件",
        "en": "Pairs file"
      },
      "kind": "text",
      "default": {
        "text": "folder_pairs.json"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "move"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "collision",
      "title": {
        "zh": "碰撞解析",
        "en": "Collision resolver"
      },
      "fieldIds": [
        "action",
        "sourcePaths",
        "targetPath",
        "targetNames",
        "destinationPath",
        "similarityThreshold",
        "moveDirection",
        "conflictPolicy",
        "pairsFileName",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "sourcePaths",
      "slot": "sourcePaths",
      "transform": "lines"
    },
    {
      "fieldId": "targetPath",
      "slot": "targetPath",
      "transform": "identity"
    },
    {
      "fieldId": "targetNames",
      "slot": "targetNames",
      "transform": "delimited"
    },
    {
      "fieldId": "destinationPath",
      "slot": "destinationPath",
      "transform": "identity"
    },
    {
      "fieldId": "similarityThreshold",
      "slot": "similarityThreshold",
      "transform": "identity"
    },
    {
      "fieldId": "moveDirection",
      "slot": "moveDirection",
      "transform": "trim"
    },
    {
      "fieldId": "conflictPolicy",
      "slot": "conflictPolicy",
      "transform": "trim"
    },
    {
      "fieldId": "pairsFileName",
      "slot": "pairsFileName",
      "transform": "identity"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "move"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认执行目录移动",
      "en": "Confirm folder moves"
    },
    "body": {
      "zh": "匹配目录将按冲突策略移动，覆盖无法撤销。",
      "en": "Matched folders will be moved using the conflict policy."
    },
    "confirmLabel": {
      "zh": "确认移动",
      "en": "Move"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false
}
