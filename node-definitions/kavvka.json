{
  "definitionVersion": 1,
  "nodeId": "kavvka",
  "title": {
    "zh": "Kavvka",
    "en": "Kavvka"
  },
  "description": {
    "zh": "通过扫描、移动同源文件并生成 include 路径，为 Czkawka 对比准备图像文件夹。",
    "en": "Prepare image folders for Czkawka comparison by scanning, moving siblings, and generating include paths."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描候选",
        "en": "Scan candidates"
      },
      "helpKey": "action.scan"
    },
    {
      "id": "plan",
      "label": {
        "zh": "◌ 预演路径",
        "en": "Plan paths"
      },
      "helpKey": "action.plan"
    },
    {
      "id": "process",
      "label": {
        "zh": "↳ 实际整理",
        "en": "Process folders"
      },
      "helpKey": "action.process"
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "工作流",
        "en": "Workflow"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描候选",
            "en": "Scan candidates"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "◌ 预演路径",
            "en": "Plan paths"
          }
        },
        {
          "value": {
            "text": "process"
          },
          "label": {
            "zh": "↳ 实际整理",
            "en": "Process folders"
          }
        }
      ],
      "default": {
        "text": "scan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "scanRoots",
      "label": {
        "zh": "扫描根目录",
        "en": "Scan roots"
      },
      "kind": "path-list",
      "lines": 5,
      "placeholder": {
        "zh": "每行一个要扫描的目录",
        "en": "One scan root per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "scan"
                ]
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "paths",
      "label": {
        "zh": "源目录",
        "en": "Source folders"
      },
      "kind": "path-list",
      "lines": 5,
      "placeholder": {
        "zh": "每行一个待比较的画集目录",
        "en": "One gallery folder per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": true
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "scan"
                ]
              },
              "negated": true
            }
          }
        }
      ]
    },
    {
      "id": "keywordText",
      "label": {
        "zh": "匹配关键词",
        "en": "Match keywords"
      },
      "kind": "multiline",
      "lines": 3,
      "default": {
        "text": ". 画集, 画集, CG, 图集, 作品集, artbook, gallery"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "scanDepth",
      "label": {
        "zh": "扫描深度",
        "en": "Scan depth"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 12,
        "step": 1
      },
      "default": {
        "number": 3
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerInRange"
          }
        }
      ]
    },
    {
      "id": "force",
      "label": {
        "zh": "允许移动同级目录",
        "en": "Move sibling folders"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": true
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": true
        }
      },
      "rules": []
    },
    {
      "id": "strictArtist",
      "label": {
        "zh": "严格画师目录",
        "en": "Require [artist] folder"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": true
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "workbench",
      "title": {
        "zh": "Czkawka 路径工作台",
        "en": "Czkawka path workbench"
      },
      "fieldIds": [
        "action",
        "scanRoots",
        "paths",
        "keywordText",
        "scanDepth",
        "force",
        "dryRun",
        "strictArtist"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "scanRoots",
      "slot": "scanRoots",
      "transform": "delimited"
    },
    {
      "fieldId": "paths",
      "slot": "paths",
      "transform": "delimited"
    },
    {
      "fieldId": "keywordText",
      "slot": "keywordText",
      "transform": "identity"
    },
    {
      "fieldId": "scanDepth",
      "slot": "scanDepth",
      "transform": "asInteger"
    },
    {
      "fieldId": "force",
      "slot": "force",
      "transform": "asBoolean"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean",
      "defaultExport": "default_dry_run"
    },
    {
      "fieldId": "strictArtist",
      "slot": "strictArtist",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "process"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认移动同级目录",
      "en": "Confirm folder moves"
    },
    "body": {
      "zh": "将把当前目录的同级目录移入 #compare。请先检查右侧的预演路径。",
      "en": "Sibling folders will be moved into #compare. Review the path plan first."
    },
    "confirmLabel": {
      "zh": "确认移动",
      "en": "Move folders"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "dashboard": {
    "title": {
      "zh": "Kavvka",
      "en": "Kavvka"
    },
    "primary": {
      "type": "field",
      "fieldId": "action"
    },
    "metrics": []
  }
}
