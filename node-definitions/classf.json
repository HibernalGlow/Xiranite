{
  "definitionVersion": 1,
  "nodeId": "classf",
  "title": {
    "zh": "ClassF",
    "en": "ClassF"
  },
  "description": {
    "zh": "递归检测所有文件，并在不丢失路径分类的前提下分流到 already、del 或 wait。",
    "en": "Classify detected files into already, del, or wait without losing path context."
  },
  "actions": [
    {
      "id": "plan",
      "label": {
        "zh": "预演",
        "en": "Plan"
      },
      "helpKey": "action.plan"
    },
    {
      "id": "classify",
      "label": {
        "zh": "执行",
        "en": "Classify"
      },
      "helpKey": "action.classify"
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "预演",
            "en": "Plan"
          }
        },
        {
          "value": {
            "text": "classify"
          },
          "label": {
            "zh": "执行",
            "en": "Classify"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "SameA 压缩包根目录",
        "en": "SameA archive roots"
      },
      "kind": "path-list",
      "lines": 4,
      "placeholder": {
        "zh": "每行一个压缩包根目录",
        "en": "One archive root per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "crashuSourcesText",
      "label": {
        "zh": "CrashU 匹配源目录",
        "en": "CrashU source directories"
      },
      "kind": "path-list",
      "lines": 3,
      "placeholder": {
        "zh": "每行一个匹配源目录",
        "en": "One matching source directory per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "placementMode",
      "label": {
        "zh": "放置位置",
        "en": "Placement"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "local"
          },
          "label": {
            "zh": "文件所在目录",
            "en": "Beside each file"
          }
        },
        {
          "value": {
            "text": "root"
          },
          "label": {
            "zh": "给定根目录（保留相对路径）",
            "en": "Target root (preserve paths)"
          }
        }
      ],
      "default": {
        "text": "local"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "targetDir",
      "label": {
        "zh": "分流目标根目录",
        "en": "Classification target root"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "required"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "fieldEquals",
                "fieldId": "placementMode",
                "value": {
                  "text": "root"
                }
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "transferMode",
      "label": {
        "zh": "迁移方式",
        "en": "Transfer mode"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "move"
          },
          "label": {
            "zh": "移动",
            "en": "Move"
          }
        },
        {
          "value": {
            "text": "copy"
          },
          "label": {
            "zh": "复制",
            "en": "Copy"
          }
        }
      ],
      "default": {
        "text": "move"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "alreadyEnabled",
      "label": {
        "zh": "启用 already 队列",
        "en": "Enable already queue"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "waitEnabled",
      "label": {
        "zh": "启用 wait 队列",
