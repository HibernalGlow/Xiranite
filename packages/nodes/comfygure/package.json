{
  "name": "@xiranite/node-comfygure",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Compile fixed Comfygure programs into validated local ComfyUI API prompt graphs.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "default": "./dist/project.js"
    },
    "./platform": {
      "types": "./dist/platform.d.ts",
      "default": "./dist/platform.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:tsc": "tsc -p tsconfig.json",
    "test": "vitest run src --passWithNoTests",
    "preflight:local": "bun src/live-preflight.ts",
    "audit:workflow": "bun src/workflow-audit.ts"
  },
  "dependencies": {
    "@stable-canvas/comfyui-client": "1.5.9",
    "@xiranite/config": "workspace:*",
    "@xiranite/contract": "workspace:*",
    "@xiranite/shared": "workspace:*",
    "fflate": "^0.8.3",
    "json-canonicalize": "2.0.0",
    "json-rules-engine": "7.3.1",
    "jsonrepair": "3.15.0",
    "liquidjs": "10.27.2",
    "p-queue": "9.3.1",
    "ts-pattern": "5.9.0",
    "write-file-atomic": "7.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
