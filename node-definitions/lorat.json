{
  "definitionVersion": 1,
  "nodeId": "lorat",
  "title": {
    "zh": "Lorat",
    "en": "Lorat"
  },
  "description": {
    "zh": "收集下载的 LoRA、推断触发词、写入 sidecar 文件，并导出 TriggerDB JSON。",
    "en": "Collect LoRA downloads, infer triggers, write sidecars, and export TriggerDB JSON."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描模型",
        "en": "⌕ Scan"
      }
    },
    {
      "id": "collect",
      "label": {
        "zh": "⊕ 收集入库",
        "en": "⊕ Collect"
      }
    },
    {
      "id": "apply_db",
      "label": {
        "zh": "◇ 应用 TriggerDB",
        "en": "◇ Apply DB"
      }
    },
    {
      "id": "write_triggers",
      "label": {
        "zh": "✓ 写入触发词",
        "en": "✓ Write triggers"
      }
    },
    {
      "id": "mark_no_trigger",
      "label": {
        "zh": "○ 标记无触发词",
        "en": "○ No trigger"
      }
    },
    {
      "id": "export_db",
      "label": {
        "zh": "⇩ 导出 TriggerDB",
        "en": "⇩ Export DB"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描模型",
            "en": "⌕ Scan"
          }
        },
        {
          "value": {
            "text": "collect"
          },
          "label": {
            "zh": "⊕ 收集入库",
            "en": "⊕ Collect"
          }
        },
        {
          "value": {
            "text": "apply_db"
          },
          "label": {
            "zh": "◇ 应用 TriggerDB",
            "en": "◇ Apply DB"
          }
        },
        {
          "value": {
            "text": "write_triggers"
          },
          "label": {
            "zh": "✓ 写入触发词",
            "en": "✓ Write triggers"
          }
        },
        {
          "value": {
            "text": "mark_no_trigger"
          },
          "label": {
            "zh": "○ 标记无触发词",
            "en": "○ No trigger"
          }
        },
        {
          "value": {
            "text": "export_db"
          },
          "label": {
            "zh": "⇩ 导出 TriggerDB",
            "en": "⇩ Export DB"
          }
        }
      ],
      "default": {
        "text": "scan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "folderPath",
      "label": {
        "zh": "LoRA 目录",
        "en": "LoRA folder"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "collect"
            ]
          },
          "negated": true
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "scan"
                ]
              },
              "negated": false
            }
          },
          "message": {
            "zh": "请输入 LoRA 目录。",
            "en": "Enter a LoRA folder."
          }
        }
      ]
    },
    {
      "id": "collectionRoot",
      "label": {
        "zh": "收集根目录",
        "en": "Collection root"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "collect"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "collect"
                ]
              },
              "negated": false
            }
          },
          "message": {
            "zh": "请输入收集根目录和待收集项目。",
            "en": "Enter a collection root and items."
          }
        }
      ]
    },
    {
      "id": "collectionItemsJson",
      "label": {
        "zh": "待收集项目 JSON",
        "en": "Collection items JSON"
      },
      "kind": "text",
      "default": {
        "text": "[]"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "collect"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "custom",
            "exportName": "validate_collection_items"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "collect"
                ]
              },
              "negated": false
            }
          },
          "message": {
            "zh": "请输入收集根目录和待收集项目。",
            "en": "Enter a collection root and items."
          }
        }
      ]
    },
    {
      "id": "triggerDbJson",
      "label": {
        "zh": "TriggerDB JSON",
        "en": "TriggerDB JSON"
      },
      "kind": "text",
      "default": {
        "text": "{}"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "apply_db",
              "export_db"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "rowsJson",
      "label": {
        "zh": "模型行 JSON",
        "en": "Rows JSON"
      },
      "kind": "text",
      "default": {
        "text": "[]"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan",
              "collect"
            ]
          },
          "negated": true
        }
      },
      "rules": [
        {
          "rule": {
            "type": "custom",
            "exportName": "validate_rows"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "scan",
                  "collect"
                ]
              },
              "negated": true
            }
          },
          "message": {
            "zh": "请先扫描模型或输入模型行 JSON。",
            "en": "Scan models or enter rows JSON first."
          }
        }
      ]
    },
    {
      "id": "selectedKeys",
      "label": {
        "zh": "选中模型键",
        "en": "Selected keys"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "write_triggers",
              "mark_no_trigger"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "search",
      "label": {
        "zh": "搜索",
        "en": "Search"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "statusFilter",
      "label": {
        "zh": "状态过滤",
        "en": "Status filter"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "all"
          },
          "label": {
            "zh": "全部",
            "en": "All"
          }
        },
        {
          "value": {
            "text": "missing"
          },
          "label": {
            "zh": "缺失",
            "en": "Missing"
          }
        },
        {
          "value": {
            "text": "trigger"
          },
          "label": {
            "zh": "有触发词",
            "en": "Trigger"
          }
        },
        {
          "value": {
            "text": "notrigger"
          },
          "label": {
            "zh": "无触发词",
            "en": "No trigger"
          }
        }
      ],
      "default": {
        "text": "all"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "collectionOverwrite",
      "label": {
        "zh": "覆盖同名模型",
        "en": "Overwrite"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "collect"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "collectionCreateModelFolder",
      "label": {
        "zh": "每个 LoRA 单独建文件夹",
        "en": "Create a folder per LoRA"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "collect"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "library",
      "title": {
        "zh": "模型库",
        "en": "Model library"
      },
      "fieldIds": [
        "action",
        "folderPath",
        "collectionRoot",
        "collectionItemsJson",
        "triggerDbJson",
        "rowsJson",
        "selectedKeys",
        "search",
        "statusFilter",
        "collectionOverwrite",
        "collectionCreateModelFolder"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "folderPath",
      "slot": "folderPath",
      "transform": "trim"
    },
    {
      "fieldId": "collectionRoot",
      "slot": "collectionRoot",
      "transform": "trim"
    },
    {
      "fieldId": "collectionItemsJson",
      "slot": "collectionItems",
      "transform": "identity",
      "defaultExport": "parse_collection_items_json"
    },
    {
      "fieldId": "collectionOverwrite",
      "slot": "collectionOverwrite",
      "transform": "asBoolean"
    },
    {
      "fieldId": "collectionCreateModelFolder",
      "slot": "collectionCreateModelFolder",
      "transform": "asBoolean"
    },
    {
      "fieldId": "triggerDbJson",
      "slot": "triggerDbJson",
      "transform": "identity"
    },
    {
      "fieldId": "rowsJson",
      "slot": "rows",
      "transform": "identity",
      "defaultExport": "parse_rows_json"
    },
    {
      "fieldId": "selectedKeys",
      "slot": "selectedKeys",
      "transform": "delimited"
    },
    {
      "fieldId": "search",
      "slot": "search",
      "transform": "trim"
    },
    {
      "fieldId": "statusFilter",
      "slot": "statusFilter",
      "transform": "trim"
    }
  ],
  "danger": {
    "type": "actionIn",
    "actionField": "action",
    "dangerous": [
      "write_triggers",
      "mark_no_trigger"
    ]
  },
  "dangerPromptExport": "danger_prompt",
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "dashboard": {
    "title": {
      "zh": "LoRaT",
      "en": "LoRaT"
    },
    "primary": {
      "type": "firstNonEmpty",
      "fieldIds": [
        "folderPath",
        "collectionRoot"
      ],
      "fallbackText": {
        "zh": "LoRaT",
        "en": "LoRaT"
      }
    },
    "secondary": {
      "type": "field",
      "fieldId": "action"
    },
    "metrics": []
  },
  "help": {
    "whenToUse": {
      "zh": [
        "当需要从工作区 UI 或 CLI 使用该节点的图像工作流时，使用 Lorat。"
      ],
      "en": [
        "Use Lorat when you need this node's image workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 Lorat，并在节点面板上运行。",
          "en": "Deploy Lorat from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 Lorat 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "运行预览或主操作，查看结果与日志后再应用真实变更。"
          ],
          "en": [
            "Open the module registry and deploy Lorat to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "LoRA 收集",
          "en": "LoRA collection"
        },
        "summary": {
          "zh": "把下载完成的 LoRA 收入指定模型库，同时保留预览图和触发词。",
          "en": "Collect a downloaded LoRA into the target library without losing its preview or trigger words."
        },
        "ui": {
          "zh": [
            "打开“收集”页，在桌面端拖入一个或多个 .safetensors、.ckpt 或 .pt 文件。",
            "选择相对目录，按需绑定图片并编辑触发词标签。",
            "确认收集后复制模型、预览图和 .trigger.txt sidecar；未开启覆盖时会跳过同名文件。"
          ],
          "en": [
            "Open the Collect tab and drop one or more .safetensors, .ckpt, or .pt files from the desktop app.",
            "Choose the relative library directory, bind an optional image, and edit the trigger tags.",
            "Confirm collection to copy the model, preview image, and .trigger.txt sidecar. Existing files are skipped unless overwrite is enabled."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端运行 Lorat。",
          "en": "Run Lorat directly from a terminal."
        },
        "cli": {
          "zh": [
            "命令支持交互式提示时，运行 `xiranite lorat` 进入引导模式。",
            "运行 `xiranite lorat --help` 查看该节点命令的完整参数与子命令。"
          ],
          "en": [
            "Run `xiranite lorat` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite lorat --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite lorat",
        "description": {
          "zh": "打开节点 CLI，或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite lorat",
            "description": {
              "zh": "启动该节点的交互式终端工作流。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite lorat --help",
            "description": {
              "zh": "显示节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help lorat",
            "description": {
              "zh": "在根 CLI 中渲染这条共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "修改文件前优先使用预览或 dry-run 模式。",
          "处理大文件夹时保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
