{
  "definitionVersion": 1,
  "nodeId": "coveru",
  "title": {
    "zh": "CoverU",
    "en": "CoverU"
  },
  "description": {
    "zh": "从归档和图片文件夹中提取封面图片。",
    "en": "Extract cover images from archives and image folders."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描",
        "en": "Scan"
      }
    },
    {
      "id": "plan",
      "label": {
        "zh": "◌ 预演",
        "en": "Plan"
      }
    },
    {
      "id": "extract",
      "label": {
        "zh": "▣ 提取",
        "en": "Extract"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "封面操作",
        "en": "Cover action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描",
            "en": "Scan"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "◌ 预演",
            "en": "Plan"
          }
        },
        {
          "value": {
            "text": "extract"
          },
          "label": {
            "zh": "▣ 提取",
            "en": "Extract"
          }
        }
      ],
      "default": {
        "text": "scan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "paths",
      "label": {
        "zh": "输入队列",
        "en": "Input queue"
      },
      "kind": "path-list",
      "lines": 5,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "outputMode",
      "label": {
        "zh": "输出位置",
        "en": "Output location"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "alongside"
          },
          "label": {
            "zh": "同目录",
            "en": "Alongside"
          }
        },
        {
          "value": {
            "text": "directory"
          },
          "label": {
            "zh": "指定目录",
            "en": "Directory"
          }
        }
      ],
      "default": {
        "text": "alongside"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "outputDir",
      "label": {
        "zh": "输出目录",
        "en": "Output directory"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "fieldEquals",
            "fieldId": "outputMode",
            "value": {
              "text": "directory"
            }
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "preferred",
      "label": {
        "zh": "优先名称",
        "en": "Preferred names"
      },
      "kind": "text",
      "default": {
        "text": "cover, folder, front, 000, 001"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "recursive",
      "label": {
        "zh": "递归扫描",
        "en": "Recursive"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "overwrite",
      "label": {
        "zh": "覆盖已有文件",
        "en": "Overwrite"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "covers",
      "title": {
        "zh": "封面提取",
        "en": "Cover extraction"
      },
      "fieldIds": [
        "action",
        "paths",
        "outputMode",
        "outputDir",
        "preferred",
        "recursive",
        "overwrite",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "paths",
      "slot": "paths",
      "transform": "delimited"
    },
    {
      "fieldId": "outputMode",
      "slot": "outputMode",
      "transform": "trim"
    },
    {
      "fieldId": "outputDir",
      "slot": "outputDir",
      "transform": "identity"
    },
    {
      "fieldId": "preferred",
      "slot": "preferredNames",
      "transform": "delimited"
    },
    {
      "fieldId": "recursive",
      "slot": "recursive",
      "transform": "asBoolean"
    },
    {
      "fieldId": "overwrite",
      "slot": "overwrite",
      "transform": "asBoolean"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean",
      "defaultExport": "default_dry_run"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "extract"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认提取封面",
      "en": "Confirm cover extraction"
    },
    "body": {
      "zh": "将把评分最高的封面提取到目标位置。",
      "en": "Highest-scored covers will be extracted to their targets."
    },
    "confirmLabel": {
      "zh": "确认提取",
      "en": "Extract"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": true,
  "help": {
    "whenToUse": {
      "zh": [
        "当归档封面需要被检测、审阅并提取到一个可预测的输出位置时使用 CoverU。"
      ],
      "en": [
        "Use CoverU when archive cover files need to be detected, reviewed, and extracted into a predictable output location."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "粘贴归档或文件夹路径，查看封面联系表，再提取选中的封面候选项。",
          "en": "Paste archive or folder paths, review the cover contact sheet, then extract selected cover candidates."
        },
        "ui": {
          "zh": [
            "粘贴 ZIP/CBZ 归档、散图文件或包含它们的文件夹。",
            "运行扫描或计划，查看封面候选项与不支持的归档。",
            "在输出目录与覆盖策略正确无误后，再从预览切换到提取。"
          ],
          "en": [
            "Paste ZIP/CBZ archives, loose image files, or folders that contain them.",
            "Run scan or plan to inspect cover candidates and unsupported archives.",
            "Switch from preview to extract only after the output directory and overwrite policy are correct."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端运行 CoverU。",
          "en": "Run CoverU directly from a terminal."
        },
        "cli": {
          "zh": [
            "运行 `xiranite coveru plan <path>` 查看封面候选项。",
            "运行 `xiranite coveru extract <path> --output-dir <dir>` 写入封面文件。"
          ],
          "en": [
            "Run `xiranite coveru plan <path>` to inspect cover candidates.",
            "Run `xiranite coveru extract <path> --output-dir <dir>` to write cover files."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "规划封面提取",
          "en": "Plan cover extraction"
        },
        "command": "xiranite coveru plan D:/archives",
        "description": {
          "zh": "检查归档并打印摘要，不写入文件。",
          "en": "Inspect archives and print a summary without writing files."
        },
        "examples": [
          {
            "label": {
              "zh": "提取到目录",
              "en": "Extract to a directory"
            },
            "command": "xiranite coveru extract D:/archives --output-dir D:/covers",
            "description": {
              "zh": "将检测到的封面提取到一个输出文件夹中。",
              "en": "Extract detected covers into one output folder."
            }
          },
          {
            "label": {
              "zh": "允许覆盖",
              "en": "Allow overwrite"
            },
            "command": "xiranite coveru extract D:/archives --output-dir D:/covers --overwrite",
            "description": {
              "zh": "当文件名冲突时替换已有的输出文件。",
              "en": "Replace existing output files when names collide."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "处理大型文件夹时先运行计划。",
          "覆盖默认是关闭的。",
          "不支持的归档格式会被报告，而不是调用外部工具。"
        ],
        "en": [
          "Plan first when processing a large folder.",
          "Overwrite is disabled by default.",
          "Unsupported archive formats are reported instead of invoking external tools."
        ]
      }
    }
  }
}
