    {
      "fieldId": "dstEncoding",
      "slot": "dstEncoding",
      "transform": "identity",
      "defaultExport": "effective_dst_encoding"
    },
    {
      "fieldId": "preset",
      "slot": "transform",
      "transform": "identity",
      "defaultExport": "preset_transform"
    },
    {
      "fieldId": "strategy",
      "slot": "strategy",
