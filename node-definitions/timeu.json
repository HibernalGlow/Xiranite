{
  "definitionVersion": 1,
  "nodeId": "timeu",
  "title": {
    "zh": "TimeU",
    "en": "TimeU"
  },
  "description": {
    "zh": "从 JSON 记录备份和恢复文件时间戳。",
    "en": "Back up and restore file timestamps from JSON records."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "检查",
        "en": "Scan"
      }
    },
    {
      "id": "backup",
      "label": {
        "zh": "备份时间戳",
        "en": "Back up"
      }
    },
    {
      "id": "restore",
      "label": {
        "zh": "恢复时间戳",
        "en": "Restore"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "检查",
            "en": "Scan"
          }
        },
        {
          "value": {
            "text": "backup"
          },
          "label": {
            "zh": "备份时间戳",
            "en": "Back up"
          }
        },
        {
          "value": {
            "text": "restore"
          },
          "label": {
            "zh": "恢复时间戳",
            "en": "Restore"
          }
        }
      ],
      "default": {
        "text": "scan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "listText",
      "label": {
        "zh": "路径队列",
        "en": "Path queue"
      },
      "kind": "path-list",
      "lines": 7,
      "placeholder": {
        "zh": "每行一个文件或目录",
        "en": "One file or directory per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
          }
        }
      ]
    },
    {
      "id": "recordPath",
      "label": {
        "zh": "时间记录文件",
        "en": "Timestamp record file"
      },
      "kind": "text",
      "placeholder": {
        "zh": "timeu-timestamps.json",
        "en": "timeu-timestamps.json"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "recursive",
      "label": {
        "zh": "递归目录",
        "en": "Recurse directories"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "includeDirectories",
      "label": {
        "zh": "包含目录自身",
        "en": "Include directories"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "预演模式",
        "en": "Dry-run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "scan"
            ]
          },
          "negated": true
        }
      },
      "rules": []
    }
  ],
  "groups": [],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "listText",
      "slot": "listText",
      "transform": "identity"
    },
    {
      "fieldId": "recordPath",
      "slot": "recordPath",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "recursive",
      "slot": "recursive",
      "transform": "asBoolean"
    },
    {
      "fieldId": "includeDirectories",
      "slot": "includeDirectories",
      "transform": "asBoolean"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "scan"
          ]
        },
        "negated": true
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "在归档移动、重命名或恢复任务前，需要保留文件的修改/访问时间时使用 TimeU。"
      ],
      "en": [
        "Use TimeU before archive moves, renames, or recovery jobs when file modified/accessed times must be preserved."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "备份",
          "en": "Backup"
        },
        "summary": {
          "zh": "在批量操作前记录时间戳。",
          "en": "Record timestamps before a batch operation."
        },
        "ui": {
          "zh": [
            "粘贴文件或文件夹路径。",
            "预览时间戳记录。",
            "关闭试运行后运行备份，写入 JSON 记录文件。"
          ],
          "en": [
            "Paste file or folder paths.",
            "Preview timestamp records.",
            "Run backup with dry-run off to write the JSON record file."
          ]
        }
      },
      {
        "title": {
          "zh": "恢复",
          "en": "Restore"
        },
        "summary": {
          "zh": "将存储的 atime/mtime 值写回现有文件。",
          "en": "Apply stored atime/mtime values back to existing files."
        },
        "cli": {
          "zh": [
            "运行 `xiranite timeu restore D:/folder --record D:/folder/timeu-timestamps.json`。",
            "先加 `--dry-run` 预览缺失路径和已变更的时间戳。"
          ],
          "en": [
            "Run `xiranite timeu restore D:/folder --record D:/folder/timeu-timestamps.json`.",
            "Run with `--dry-run` first to preview missing paths and changed timestamps."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "备份时间戳",
          "en": "Backup timestamps"
        },
        "command": "xiranite timeu backup D:/archive --record D:/archive/timeu-timestamps.json",
        "description": {
          "zh": "为文件夹下的文件写入 JSON 时间戳记录。",
          "en": "Write a JSON timestamp record for files under a folder."
        },
        "examples": [
          {
            "label": {
              "zh": "恢复时间戳",
              "en": "Restore timestamps"
            },
            "command": "xiranite timeu restore D:/archive --record D:/archive/timeu-timestamps.json",
            "description": {
              "zh": "恢复已存储的访问和修改时间。",
              "en": "Restore stored access and modified times."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "默认开启试运行。",
          "创建和变更时间仅作为参考记录；原生运行时只恢复访问和修改时间。",
          "缺失路径会被报告并跳过。"
        ],
        "en": [
          "Dry-run is enabled by default.",
          "Birth and change times are recorded for reference; the native runtime restores access and modified times.",
          "Missing paths are reported and skipped."
        ]
      }
    }
  }
}
