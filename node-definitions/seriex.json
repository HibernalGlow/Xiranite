{
  "definitionVersion": 1,
  "nodeId": "seriex",
  "title": {
    "zh": "Seriex",
    "en": "Seriex"
  },
  "description": {
    "zh": "检测相关归档文件，规划系列文件夹，并安全地移动它们。",
    "en": "Detect related archive files, plan series folders, and move them safely."
  },
  "actions": [
    {
      "id": "plan",
      "label": {
        "zh": "◎ 聚类预览",
        "en": "◎ Cluster plan"
      }
    },
    {
      "id": "execute",
      "label": {
        "zh": "▶ 执行归档",
        "en": "▶ Execute"
      }
    },
    {
      "id": "apply",
      "label": {
        "zh": "↯ 应用计划",
        "en": "↯ Apply plan"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "◎ 聚类预览",
            "en": "◎ Cluster plan"
          }
        },
        {
          "value": {
            "text": "execute"
          },
          "label": {
            "zh": "▶ 执行归档",
            "en": "▶ Execute"
          }
        },
        {
          "value": {
            "text": "apply"
          },
          "label": {
            "zh": "↯ 应用计划",
            "en": "↯ Apply plan"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "directoryPath",
      "label": {
        "zh": "来源目录",
        "en": "Source directory"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
          }
        }
      ]
    },
    {
      "id": "configPath",
      "label": {
        "zh": "配置文件",
        "en": "Config file"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "threshold",
      "label": {
        "zh": "相似度",
        "en": "Similarity"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 100,
        "step": 1
      },
      "default": {
        "number": 75
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerInRange"
          }
        }
      ]
    },
    {
      "id": "ratioThreshold",
      "label": {
        "zh": "Ratio",
        "en": "Ratio"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 100,
        "step": 1
      },
      "default": {
        "number": 75
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerInRange"
          }
        }
      ]
    },
    {
      "id": "partialThreshold",
      "label": {
        "zh": "Partial",
        "en": "Partial"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 100,
        "step": 1
      },
      "default": {
        "number": 85
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerInRange"
          }
        }
      ]
    },
    {
      "id": "tokenThreshold",
      "label": {
        "zh": "Token",
        "en": "Token"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 100,
        "step": 1
      },
      "default": {
        "number": 80
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerInRange"
          }
        }
      ]
    },
    {
      "id": "lengthDiffMax",
      "label": {
        "zh": "长度差",
        "en": "Length diff"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.05
      },
      "default": {
        "number": 0.3
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "addPrefix",
      "label": {
        "zh": "添加前缀",
        "en": "Add prefix"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "prefix",
      "label": {
        "zh": "系列前缀",
        "en": "Prefix"
      },
      "kind": "text",
      "default": {
        "text": "[#s]"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "fieldTrue",
            "fieldId": "addPrefix"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "knownSeriesDirs",
      "label": {
        "zh": "已知系列目录",
        "en": "Known directories"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "knownSeriesNames",
      "label": {
        "zh": "已知系列名",
        "en": "Known names"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "scan",
      "title": {
        "zh": "系列扫描",
        "en": "Series scan"
      },
      "fieldIds": [
        "action",
        "directoryPath",
        "configPath",
        "threshold",
        "ratioThreshold",
        "partialThreshold",
        "tokenThreshold",
        "lengthDiffMax",
        "addPrefix",
        "prefix",
        "knownSeriesDirs",
        "knownSeriesNames",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "directoryPath",
      "slot": "directoryPath",
      "transform": "identity"
    },
    {
      "fieldId": "configPath",
      "slot": "configPath",
      "transform": "identity"
    },
    {
      "fieldId": "threshold",
      "slot": "threshold",
      "transform": "asInteger"
    },
    {
      "fieldId": "ratioThreshold",
      "slot": "ratioThreshold",
      "transform": "asInteger"
    },
    {
      "fieldId": "partialThreshold",
      "slot": "partialThreshold",
      "transform": "asInteger"
    },
    {
      "fieldId": "tokenThreshold",
      "slot": "tokenThreshold",
      "transform": "asInteger"
    },
    {
      "fieldId": "lengthDiffMax",
      "slot": "lengthDiffMax",
      "transform": "identity"
    },
    {
      "fieldId": "addPrefix",
      "slot": "addPrefix",
      "transform": "asBoolean"
    },
    {
      "fieldId": "prefix",
      "slot": "prefix",
      "transform": "identity"
    },
    {
      "fieldId": "knownSeriesDirs",
      "slot": "knownSeriesDirs",
      "transform": "delimited"
    },
    {
      "fieldId": "knownSeriesNames",
      "slot": "knownSeriesNames",
      "transform": "delimited"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "execute",
            "apply"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认移动系列文件",
      "en": "Confirm series moves"
    },
    "body": {
      "zh": "文件将按聚类计划移动到系列目录。",
      "en": "Files will move into clustered series directories."
    },
    "confirmLabel": {
      "zh": "确认执行",
      "en": "Execute"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "需要从工作区 UI 或 CLI 使用此节点的文件工作流时，可使用 Seriex。"
      ],
      "en": [
        "Use Seriex when you need this node's file workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 Seriex，并在节点面板中运行。",
          "en": "Deploy Seriex from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 Seriex 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，查看结果与日志后再实际应用变更。"
          ],
          "en": [
            "Open the module registry and deploy Seriex to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端中运行 Seriex。",
          "en": "Run Seriex directly from a terminal."
        },
        "cli": {
          "zh": [
            "当命令支持交互式提示时，运行 `xiranite seriex` 进入引导模式。",
            "运行 `xiranite seriex --help` 查看节点命令的具体标志与子命令。"
          ],
          "en": [
            "Run `xiranite seriex` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite seriex --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite seriex",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属标志。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite seriex",
            "description": {
              "zh": "启动节点的交互式终端工作流。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令标志",
              "en": "Command flags"
            },
            "command": "xiranite seriex --help",
            "description": {
              "zh": "查看节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help seriex",
            "description": {
              "zh": "在根 CLI 中渲染此共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "修改文件前，优先使用预览或试运行模式。",
          "处理大型文件夹时，请保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
