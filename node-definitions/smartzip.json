{
  "definitionVersion": 1,
  "nodeId": "smartzip",
  "title": {
    "zh": "SmartZip",
    "en": "SmartZip"
  },
  "description": {
    "zh": "使用自动检测 7-Zip 的 TypeScript 归档工作流。",
    "en": "TypeScript archive workflows with automatic 7-Zip discovery."
  },
  "actions": [
    {
      "id": "status",
      "label": {
        "zh": "状态",
        "en": "Status"
      }
    },
    {
      "id": "inspect_codepage",
      "label": {
        "zh": "预检文件名编码",
        "en": "Inspect filename encoding"
      }
    },
    {
      "id": "extract",
      "label": {
        "zh": "智能提取",
        "en": "Smart extract"
      }
    },
    {
      "id": "extract_codepage",
      "label": {
        "zh": "编码提取",
        "en": "Codepage extract"
      }
    },
    {
      "id": "open",
      "label": {
        "zh": "打开",
        "en": "Open"
      }
    },
    {
      "id": "archive",
      "label": {
        "zh": "压缩",
        "en": "Archive"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "归档动作",
        "en": "Archive action"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "status"
          },
          "label": {
            "zh": "状态",
            "en": "Status"
          }
        },
        {
          "value": {
            "text": "inspect_codepage"
          },
          "label": {
            "zh": "预检文件名编码",
            "en": "Inspect filename encoding"
          }
        },
        {
          "value": {
            "text": "extract"
          },
          "label": {
            "zh": "智能提取",
            "en": "Smart extract"
          }
        },
        {
          "value": {
            "text": "extract_codepage"
          },
          "label": {
            "zh": "编码提取",
            "en": "Codepage extract"
          }
        },
        {
          "value": {
            "text": "open"
          },
          "label": {
            "zh": "打开",
            "en": "Open"
          }
        },
        {
          "value": {
            "text": "archive"
          },
          "label": {
            "zh": "压缩",
            "en": "Archive"
          }
        }
      ],
      "default": {
        "text": "status"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "归档路径",
        "en": "Archive paths"
      },
      "kind": "path-list",
      "lines": 6,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "status"
            ]
          },
          "negated": true
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "status"
                ]
              },
              "negated": true
            }
          }
        }
      ]
    },
    {
      "id": "codePage",
      "label": {
        "zh": "旧 ZIP 文件名编码",
        "en": "Legacy ZIP filename encoding"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "0"
          },
          "label": {
            "zh": "自动检测",
            "en": "Auto detect"
          }
        },
        {
          "value": {
            "text": "936"
          },
          "label": {
            "zh": "GBK / CP936",
            "en": "GBK / CP936"
          }
        },
        {
          "value": {
            "text": "950"
          },
          "label": {
            "zh": "Big5 / CP950",
            "en": "Big5 / CP950"
          }
        },
        {
          "value": {
            "text": "932"
          },
          "label": {
            "zh": "Shift_JIS / CP932",
            "en": "Shift_JIS / CP932"
          }
        },
        {
          "value": {
            "text": "949"
          },
          "label": {
            "zh": "EUC-KR / CP949",
            "en": "EUC-KR / CP949"
          }
        },
        {
          "value": {
            "text": "65001"
          },
          "label": {
            "zh": "UTF-8",
            "en": "UTF-8"
          }
        }
      ],
      "default": {
        "text": "0"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract_codepage"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "iniPath",
      "label": {
        "zh": "SmartZip.ini",
        "en": "SmartZip.ini"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "recordRun",
      "label": {
        "zh": "记录运行",
        "en": "Record run"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "databasePath",
      "label": {
        "zh": "运行记录",
        "en": "Run database"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "fieldTrue",
            "fieldId": "recordRun"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "预演",
        "en": "Dry-run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "all",
        "predicates": [
          {
            "test": {
              "type": "actionIs",
              "actionField": "action",
              "allowed": [
                "status"
              ]
            },
            "negated": true
          },
          {
            "test": {
              "type": "actionIs",
              "actionField": "action",
              "allowed": [
                "inspect_codepage"
              ]
            },
            "negated": true
          }
        ]
      },
      "rules": []
    }
  ],
  "groups": [],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "lines"
    },
    {
      "fieldId": "codePage",
      "slot": "codePage",
      "transform": "asInteger"
    },
    {
      "fieldId": "iniPath",
      "slot": "iniPath",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "recordRun",
      "slot": "recordRun",
      "transform": "asBoolean"
    },
    {
      "fieldId": "databasePath",
      "slot": "databasePath",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "status"
          ]
        },
        "negated": true
      },
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "inspect_codepage"
          ]
        },
        "negated": true
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "需要从工作区 UI 或 CLI 使用该节点的文件流程时，可使用 SmartZip。"
      ],
      "en": [
        "Use SmartZip when you need this node's file workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 SmartZip，并在节点面板中运行。",
          "en": "Deploy SmartZip from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 SmartZip 部署到当前工作区。",
            "填写节点字段、管理掩码密码列表，或将路径/配置粘贴到节点面板。",
            "旧 ZIP 文件名可先运行编码预检，根据候选预览选择代码页后再解压。",
            "先运行预览或主操作，确认结果和日志后再应用真实更改。"
          ],
          "en": [
            "Open the module registry and deploy SmartZip to the current workspace.",
            "Fill the node fields, manage the masked password list, or paste paths/configuration into the node surface.",
            "For legacy ZIP names, run filename-encoding inspection and choose a candidate preview before extraction.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接从终端运行 SmartZip。",
          "en": "Run SmartZip directly from a terminal."
        },
        "cli": {
          "zh": [
            "命令支持交互提示时，运行 `xiranite smartzip` 进入引导模式。",
            "运行 `xiranite smartzip --help` 查看该节点命令的具体参数和子命令。"
          ],
          "en": [
            "Run `xiranite smartzip` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite smartzip --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite smartzip",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite smartzip",
            "description": {
              "zh": "启动该节点的交互式终端流程。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite smartzip --help",
            "description": {
              "zh": "查看节点 CLI 的子命令和选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help smartzip",
            "description": {
              "zh": "在根 CLI 中渲染本条共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "更改文件前优先使用预览或试运行模式。",
          "处理大文件夹时保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
