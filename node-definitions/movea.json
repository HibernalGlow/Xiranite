        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "match"
                ]
              },
              "negated": false
            }
