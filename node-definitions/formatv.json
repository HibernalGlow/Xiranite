{
  "definitionVersion": 1,
  "nodeId": "formatv",
  "title": {
    "zh": "FormatV",
    "en": "FormatV"
  },
  "description": {
    "zh": "扫描视频文件夹，添加/移除 .nov 后缀，并检查带前缀的重复项。",
    "en": "Scan video folders, add/remove .nov suffixes, and check prefixed duplicates."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "扫描",
        "en": "Scan"
      }
    },
    {
      "id": "add_nov",
      "label": {
        "zh": "添加 .nov",
        "en": "Add .nov"
      }
    },
    {
      "id": "remove_nov",
      "label": {
        "zh": "移除 .nov",
        "en": "Remove .nov"
      }
    },
    {
      "id": "check_duplicates",
      "label": {
        "zh": "检查重复",
        "en": "Duplicates"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "扫描",
            "en": "Scan"
          }
        },
        {
          "value": {
            "text": "add_nov"
          },
          "label": {
            "zh": "添加 .nov",
            "en": "Add .nov"
          }
        },
        {
          "value": {
            "text": "remove_nov"
          },
          "label": {
            "zh": "移除 .nov",
            "en": "Remove .nov"
          }
        },
        {
          "value": {
            "text": "check_duplicates"
          },
          "label": {
            "zh": "检查重复",
            "en": "Duplicates"
          }
        }
      ],
      "default": {
        "text": "scan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "视频路径",
        "en": "Video paths"
      },
      "kind": "path-list",
      "lines": 5,
      "placeholder": {
        "zh": "每行一个文件夹或文件",
        "en": "One folder or file per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "recursive",
      "label": {
        "zh": "递归扫描",
        "en": "Recursive scan"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "prefixName",
      "label": {
        "zh": "前缀名称",
        "en": "Prefix name"
      },
      "kind": "text",
      "default": {
        "text": "hb"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "reportPath",
      "label": {
        "zh": "重复报告路径",
        "en": "Duplicate report path"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "预演",
        "en": "Dry-run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "delimited"
    },
    {
      "fieldId": "recursive",
      "slot": "recursive",
      "transform": "asBoolean"
    },
    {
      "fieldId": "prefixName",
      "slot": "prefixName",
      "transform": "trim"
    },
    {
      "fieldId": "reportPath",
      "slot": "reportPath",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "add_nov",
            "remove_nov"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认重命名",
      "en": "Confirm rename"
    },
    "body": {
      "zh": "将执行添加/移除 .nov 后缀。",
      "en": "Files will be renamed to add/remove the .nov suffix."
    },
    "confirmLabel": {
      "zh": "确认执行",
      "en": "Run now"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "resultTable": {
    "columns": [
      {
        "id": "sourcePath",
        "label": {
          "zh": "来源",
          "en": "Source"
        },
        "width": 40
      },
      {
        "id": "targetPath",
        "label": {
          "zh": "目标",
          "en": "Target"
        },
        "width": 40
      },
      {
        "id": "status",
        "label": {
          "zh": "状态",
          "en": "Status"
        },
        "width": 12
      }
    ]
  }
}
