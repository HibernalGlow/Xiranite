    },
    {
      "fieldId": "paths",
      "slot": "paths",
      "transform": "lines"
    },
    {
      "fieldId": "preset",
      "slot": "preset",
      "transform": "trim"
    },
    {
      "fieldId": "srcEncoding",
      "slot": "srcEncoding",
      "transform": "identity",
