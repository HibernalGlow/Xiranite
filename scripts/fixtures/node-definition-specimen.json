{
  "definitionVersion": 1,
  "nodeId": "snf",
  "title": {
    "zh": "SNF",
    "en": "SNF"
  },
  "description": {
    "zh": "修复画师文件夹内的编号文件夹序列。",
    "en": "Repair numbered folder sequences inside artist folders."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描",
        "en": "⌕ Scan"
      }
    },
    {
      "id": "plan",
      "label": {
        "zh": "⌁ 预览",
        "en": "⌁ Preview"
      }
    },
    {
      "id": "rename",
      "label": {
        "zh": "⇄ 修复",
        "en": "⇄ Repair"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描",
            "en": "⌕ Scan"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌁ 预览",
            "en": "⌁ Preview"
          }
        },
        {
          "value": {
            "text": "rename"
          },
          "label": {
            "zh": "⇄ 修复",
            "en": "⇄ Repair"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "目录路径",
        "en": "Folder paths"
      },
      "kind": "path-list",
      "lines": 3,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "mode",
      "label": {
        "zh": "扫描模式",
        "en": "Scan mode"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "library"
          },
          "label": {
            "zh": "▦ 资料库",
            "en": "▦ Library"
          }
        },
        {
          "value": {
            "text": "artist"
          },
          "label": {
            "zh": "▤ 作者目录",
            "en": "▤ Artist"
          }
        }
      ],
      "default": {
        "text": "library"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "priorityKeywords",
      "label": {
        "zh": "优先关键词",
        "en": "Priority keywords"
      },
      "kind": "text",
      "default": {
        "text": "同人志,商业,单行,CG,画集"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "keepTimestamp",
      "label": {
        "zh": "保留时间",
        "en": "Keep timestamps"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "rename"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "sequence",
      "title": {
        "zh": "序号修复",
        "en": "Sequence repair"
      },
      "fieldIds": [
        "action",
        "pathsText",
        "mode",
        "priorityKeywords",
        "keepTimestamp",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "lines"
    },
    {
      "fieldId": "mode",
      "slot": "mode",
      "transform": "trim"
    },
    {
      "fieldId": "priorityKeywords",
      "slot": "priorityKeywords",
      "transform": "delimited"
    },
    {
      "fieldId": "keepTimestamp",
      "slot": "keepTimestamp",
      "transform": "asBoolean"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "rename"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认修复目录序号",
      "en": "Confirm sequence repair"
    },
    "body": {
      "zh": "就绪目录将被重命名并重新编号。",
      "en": "Ready folders will be renamed and resequenced."
    },
    "confirmLabel": {
      "zh": "确认修复",
      "en": "Repair"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "当画师文件夹包含如 1. CG、3. Commercial 这类带编号分类，且需要让序列连续时使用 SNF。"
      ],
      "en": [
        "Use SNF when artist folders contain numbered categories such as 1. CG, 3. Commercial and the sequence needs to be continuous."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "预览序列修复",
          "en": "Preview sequence repair"
        },
        "summary": {
          "zh": "生成重新编号计划而不改动文件夹。",
          "en": "Build a renumbering plan without changing folders."
        },
        "ui": {
          "zh": [
            "粘贴库根目录或画师文件夹。",
            "选择路径是库根目录还是直接的画师文件夹。",
            "在执行真实重命名前检查冲突。"
          ],
          "en": [
            "Paste a library root or artist folder.",
            "Choose whether paths are library roots or direct artist folders.",
            "Review conflicts before running live rename."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "预览库",
          "en": "Preview library"
        },
        "command": "xiranite snf plan D:/archives --mode library",
        "description": {
          "zh": "预览库根目录下每个画师文件夹的序列修复。",
          "en": "Preview sequence repairs for every artist folder under a library root."
        },
        "examples": [
          {
            "label": {
              "zh": "单个画师",
              "en": "Single artist"
            },
            "command": "xiranite snf plan D:/archives/Artist --mode artist",
            "description": {
              "zh": "预览单个画师文件夹。",
              "en": "Preview one artist folder."
            }
          },
          {
            "label": {
              "zh": "执行重命名",
              "en": "Apply rename"
            },
            "command": "xiranite snf rename D:/archives --mode library",
            "description": {
              "zh": "执行真实的序列修复。",
              "en": "Apply live sequence repairs."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "dry-run",
      "destructive": {
        "zh": [
          "rename"
        ],
        "en": [
          "rename"
        ]
      },
      "notes": {
        "zh": [
          "冲突的目标文件夹名会被报告并跳过。",
          "真实重命名默认保留文件夹时间戳。"
        ],
        "en": [
          "Conflicting target folder names are reported and skipped.",
          "Live rename keeps folder timestamps by default."
        ]
      }
    }
  }
}
