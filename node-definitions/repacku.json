{
  "definitionVersion": 1,
  "nodeId": "repacku",
  "title": {
    "zh": "RepackU",
    "en": "RepackU"
  },
  "description": {
    "zh": "分析目录树并生成安全的重打包计划。",
    "en": "Analyze folder trees and create safe repacking plans."
  },
  "actions": [
    {
      "id": "analyze",
      "label": {
        "zh": "分析",
        "en": "Analyze"
      },
      "helpKey": "action.analyze"
    },
    {
      "id": "compress",
      "label": {
        "zh": "压缩",
        "en": "Compress"
      },
      "helpKey": "action.compress"
    },
    {
      "id": "full",
      "label": {
        "zh": "完整流程",
        "en": "Full flow"
      },
      "helpKey": "action.full"
    },
    {
      "id": "single-pack",
      "label": {
        "zh": "单层打包",
        "en": "Single pack"
      },
      "helpKey": "action.single-pack"
    },
    {
      "id": "gallery-pack",
      "label": {
        "zh": "画集打包",
        "en": "Gallery pack"
      },
      "helpKey": "action.gallery-pack"
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "工作流",
        "en": "Workflow"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "analyze"
          },
          "label": {
            "zh": "分析",
            "en": "Analyze"
          }
        },
        {
          "value": {
            "text": "compress"
          },
          "label": {
            "zh": "压缩",
            "en": "Compress"
          }
        },
        {
          "value": {
            "text": "full"
          },
          "label": {
            "zh": "完整流程",
            "en": "Full flow"
          }
        },
        {
          "value": {
            "text": "single-pack"
          },
          "label": {
            "zh": "单层打包",
            "en": "Single pack"
          }
        },
        {
          "value": {
            "text": "gallery-pack"
          },
          "label": {
            "zh": "画集打包",
            "en": "Gallery pack"
          }
        }
      ],
      "default": {
        "text": "full"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "文件夹路径",
        "en": "Folder paths"
      },
      "kind": "path-list",
      "lines": 5,
      "placeholder": {
        "zh": "每行一个路径",
        "en": "One folder per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "compress"
                ]
              },
              "negated": true
            }
          }
        }
      ]
    },
    {
      "id": "types",
      "label": {
        "zh": "目标类型",
        "en": "Target types"
      },
      "kind": "text",
      "placeholder": {
        "zh": "image,document",
        "en": "image,document"
      },
      "default": {
        "text": "image"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "minCount",
      "label": {
        "zh": "最少文件数",
        "en": "Minimum files"
      },
      "kind": "number",
      "range": {
        "min": 1,
        "max": 9999,
        "step": 1
      },
      "default": {
        "number": 2
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerInRange"
          }
        }
      ]
    },
    {
      "id": "outputPath",
      "label": {
        "zh": "配置输出",
        "en": "Config output"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "configPath",
      "label": {
        "zh": "配置路径",
        "en": "Config path"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "custom",
            "exportName": "compress_needs_config_or_paths"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "compress"
                ]
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "galleryMarker",
      "label": {
        "zh": "画集标记",
        "en": "Gallery marker"
      },
      "kind": "text",
      "default": {
        "text": ". 画集"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "deleteAfter",
      "label": {
        "zh": "成功后删除源文件",
        "en": "Delete sources after success"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "预演",
        "en": "Dry-run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "delimited"
    },
    {
      "fieldId": "types",
      "slot": "types",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "minCount",
      "slot": "minCount",
      "transform": "asInteger"
    },
    {
      "fieldId": "outputPath",
      "slot": "outputPath",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "configPath",
      "slot": "configPath",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "galleryMarker",
      "slot": "galleryMarker",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "deleteAfter",
      "slot": "deleteAfter",
      "transform": "asBoolean"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "pluginExport",
    "exportName": "is_dangerous"
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认重打包",
      "en": "Confirm repacking"
    },
    "body": {
      "zh": "此操作会写入归档文件。",
      "en": "Archives will be written to disk."
    },
    "confirmLabel": {
      "zh": "确认执行",
      "en": "Run now"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false
}
