  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "rootPath",
      "slot": "rootPath",
      "transform": "identity"
    },
    {
      "fieldId": "archiveName",
      "slot": "archiveName",
      "transform": "identity"
    },
    {
      "fieldId": "subfolders",
      "slot": "subfolders",
      "transform": "delimited"
    },
    {
      "fieldId": "regexPatterns",
      "slot": "regexPatterns",
      "transform": "delimited"
    },
    {
      "fieldId": "priorityKeywords",
      "slot": "priorityKeywords",
      "transform": "delimited"
    },
    {
      "fieldId": "blacklist",
      "slot": "blacklist",
      "transform": "delimited"
    },
    {
      "fieldId": "level1Name",
      "slot": "level1Name",
      "transform": "identity"
    },
    {
      "fieldId": "movePlan",
      "slot": "movePlan",
      "transform": "identity"
    },
    {
      "fieldId": "allowMoveToUnnumbered",
      "slot": "allowMoveToUnnumbered",
      "transform": "asBoolean"
    },
    {
      "fieldId": "enableFolderMoving",
      "slot": "enableFolderMoving",
      "transform": "asBoolean"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "move",
            "move_single"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认移动归档",
      "en": "Confirm archive moves"
    },
    "body": {
      "zh": "文件和目录将按路由计划移动。",
      "en": "Files and folders will move according to the route plan."
    },
    "confirmLabel": {
      "zh": "确认移动",
      "en": "Move"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "dashboard": {
    "title": {
      "zh": "MoveA",
      "en": "MoveA"
    },
