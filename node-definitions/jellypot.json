{
  "definitionVersion": 1,
  "nodeId": "jellypot",
  "title": {
    "zh": "JellyPot",
    "en": "JellyPot"
  },
  "description": {
    "zh": "通过 JellyPot 配置检查启动 Jellyfin 与 PotPlayer。",
    "en": "Launch Jellyfin and PotPlayer with JellyPot configuration checks."
  },
  "actions": [
    {
      "id": "status",
      "label": {
        "zh": "◉ 依赖体检",
        "en": "◉ Status"
      }
    },
    {
      "id": "launch_media",
      "label": {
        "zh": "▶ 播放媒体",
        "en": "▶ Play media"
      }
    },
    {
      "id": "open_jellyfin",
      "label": {
        "zh": "◇ 打开 Jellyfin",
        "en": "◇ Open Jellyfin"
      }
    },
    {
      "id": "apply_registry",
      "label": {
        "zh": "⚠ 应用注册表",
        "en": "⚠ Apply registry"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "status"
          },
          "label": {
            "zh": "◉ 依赖体检",
            "en": "◉ Status"
          }
        },
        {
          "value": {
            "text": "launch_media"
          },
          "label": {
            "zh": "▶ 播放媒体",
            "en": "▶ Play media"
          }
        },
        {
          "value": {
            "text": "open_jellyfin"
          },
          "label": {
            "zh": "◇ 打开 Jellyfin",
            "en": "◇ Open Jellyfin"
          }
        },
        {
          "value": {
            "text": "apply_registry"
          },
          "label": {
            "zh": "⚠ 应用注册表",
            "en": "⚠ Apply registry"
          }
        }
      ],
      "default": {
        "text": "status"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "mediaPath",
      "label": {
        "zh": "媒体路径",
        "en": "Media path"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "required"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "launch_media"
                ]
              },
              "negated": false
            }
          }
        },
        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "launch_media"
                ]
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "configPath",
      "label": {
        "zh": "配置文件",
        "en": "Config file"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "potplayerPath",
      "label": {
        "zh": "PotPlayer",
        "en": "PotPlayer"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "browserPath",
      "label": {
        "zh": "浏览器",
        "en": "Browser"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "databasePath",
      "label": {
        "zh": "运行记录",
        "en": "Run database"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "recordRun",
      "label": {
        "zh": "记录运行",
        "en": "Record run"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "launch",
      "title": {
        "zh": "启动参数",
        "en": "Launch"
      },
      "fieldIds": [
        "action",
        "mediaPath",
        "configPath",
        "potplayerPath",
        "browserPath",
        "databasePath",
        "recordRun",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "mediaPath",
      "slot": "mediaPath",
      "transform": "identity"
    },
    {
      "fieldId": "configPath",
      "slot": "configPath",
      "transform": "identity"
    },
    {
      "fieldId": "potplayerPath",
      "slot": "potplayerPath",
      "transform": "identity"
    },
    {
      "fieldId": "browserPath",
      "slot": "browserPath",
      "transform": "identity"
    },
    {
      "fieldId": "databasePath",
      "slot": "databasePath",
      "transform": "identity"
    },
    {
      "fieldId": "recordRun",
      "slot": "recordRun",
      "transform": "asBoolean",
      "defaultExport": "default_record_run"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "apply_registry"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认写入注册表",
      "en": "Confirm registry write"
    },
    "body": {
      "zh": "该操作会调用 regedit 修改 PotPlayer 注册表设置。",
      "en": "This invokes regedit and changes PotPlayer settings."
    },
    "confirmLabel": {
      "zh": "确认应用",
      "en": "Apply"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "dashboard": {
    "title": {
      "zh": "JellyPot",
      "en": "JellyPot"
    },
    "primary": {
      "type": "field",
      "fieldId": "action"
    },
    "metrics": []
  },
  "help": {
    "whenToUse": {
      "zh": [
        "需要在工作区 UI 或 CLI 中使用该节点的系统工作流时，使用 JellyPot。"
      ],
      "en": [
        "Use JellyPot when you need this node's system workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 JellyPot，并在节点面板上运行。",
          "en": "Deploy JellyPot from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 JellyPot 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，再检查结果与日志，最后才应用真实变更。"
          ],
          "en": [
            "Open the module registry and deploy JellyPot to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接从终端运行 JellyPot。",
          "en": "Run JellyPot directly from a terminal."
        },
        "cli": {
          "zh": [
            "命令支持交互提示时，运行 `xiranite jellypot` 进入引导模式。",
            "运行 `xiranite jellypot --help` 查看该节点命令的具体参数与子命令。"
          ],
          "en": [
            "Run `xiranite jellypot` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite jellypot --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite jellypot",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite jellypot",
            "description": {
              "zh": "启动该节点的交互式终端流程。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite jellypot --help",
            "description": {
              "zh": "显示该节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help jellypot",
            "description": {
              "zh": "在根 CLI 中渲染该共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "执行真实操作前，请先核对配置与受影响的系统状态。",
          "可用时优先使用预览模式。"
        ],
        "en": [
          "Review configuration and affected system state before running live actions.",
          "Prefer preview modes when available."
        ]
      }
    }
  }
