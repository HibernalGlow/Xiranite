{
  "definitionVersion": 1,
  "nodeId": "samea",
  "title": {
    "zh": "SameA",
    "en": "SameA"
  },
  "description": {
    "zh": "Extract artist metadata from archive names and organize matching archives.",
    "en": "Extract artist metadata from archive names and organize matching archives."
  },
  "actions": [
    {
      "id": "plan",
      "label": {
        "zh": "⌕ 规划",
        "en": "⌕ Plan"
      }
    },
    {
      "id": "classify",
      "label": {
        "zh": "▶ 分类",
        "en": "▶ Classify"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌕ 规划",
            "en": "⌕ Plan"
          }
        },
        {
          "value": {
            "text": "classify"
          },
          "label": {
            "zh": "▶ 分类",
            "en": "▶ Classify"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "归档根目录",
        "en": "Archive roots"
      },
      "kind": "path-list",
      "lines": 4,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "ignorePathBlacklist",
      "label": {
        "zh": "忽略路径黑名单",
        "en": "Ignore path blacklist"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "minOccurrences",
      "label": {
        "zh": "最少出现次数",
        "en": "Minimum occurrences"
      },
      "kind": "number",
      "range": {
        "min": 1,
        "max": 100,
        "step": 1
      },
      "default": {
        "number": 1
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerInRange"
          }
        }
      ]
    },
    {
      "id": "centralize",
      "label": {
        "zh": "集中输出",
        "en": "Centralize output"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "预演模式",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "artistBlacklist",
      "label": {
        "zh": "画师黑名单",
        "en": "Artist blacklist"
      },
      "kind": "multiline",
      "lines": 5,
      "default": {
        "text": "pixiv\ntwitter\nvarious\nanthology\nunknown\ntrash\nartbook"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "pathBlacklist",
      "label": {
        "zh": "路径黑名单",
        "en": "Path blacklist"
      },
      "kind": "multiline",
      "lines": 5,
      "default": {
        "text": "[00画师分类]\ntrash\ntemp"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "regexBlacklist",
      "label": {
        "zh": "正则黑名单",
        "en": "Regex blacklist"
      },
      "kind": "multiline",
      "lines": 5,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "archiveExtensions",
      "label": {
        "zh": "归档扩展名",
        "en": "Archive extensions"
      },
      "kind": "multiline",
      "lines": 4,
      "default": {
        "text": ".zip\n.rar\n.7z"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "source",
      "title": {
        "zh": "来源与规则",
        "en": "Sources and rules"
      },
      "fieldIds": [
        "action",
        "pathsText",
        "ignorePathBlacklist",
        "minOccurrences",
        "centralize",
        "dryRun",
        "artistBlacklist",
        "pathBlacklist",
        "regexBlacklist",
        "archiveExtensions"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "lines"
    },
    {
      "fieldId": "ignorePathBlacklist",
      "slot": "ignorePathBlacklist",
      "transform": "asBoolean"
    },
    {
      "fieldId": "minOccurrences",
      "slot": "minOccurrences",
      "transform": "asInteger"
    },
    {
      "fieldId": "centralize",
      "slot": "centralize",
      "transform": "asBoolean"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    },
    {
      "fieldId": "artistBlacklist",
      "slot": "artistBlacklist",
      "transform": "lines"
    },
    {
      "fieldId": "pathBlacklist",
      "slot": "pathBlacklist",
      "transform": "lines"
    },
    {
      "fieldId": "regexBlacklist",
      "slot": "regexBlacklist",
      "transform": "lines"
    },
    {
      "fieldId": "archiveExtensions",
      "slot": "archiveExtensions",
      "transform": "lines"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "classify"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认实时分类",
      "en": "Confirm live classification"
    },
    "body": {
      "zh": "SameA 将移动就绪的归档文件。",
      "en": "SameA will move ready archives."
    },
    "confirmLabel": {
      "zh": "确认移动",
      "en": "Move archives"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "Use SameA before CrashU when archive names contain artist or circle metadata that should become target folders."
      ],
      "en": [
        "Use SameA before CrashU when archive names contain artist or circle metadata that should become target folders."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "Extract and organize",
          "en": "Extract and organize"
        },
        "summary": {
          "zh": "Preview detected artists, then classify matching archives.",
          "en": "Preview detected artists, then classify matching archives."
        },
        "ui": {
          "zh": [
            "Paste archive roots.",
            "Set the occurrence threshold and centralization mode.",
            "Review the plan before turning off dry run."
          ],
          "en": [
            "Paste archive roots.",
            "Set the occurrence threshold and centralization mode.",
            "Review the plan before turning off dry run."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "Preview",
          "en": "Preview"
        },
        "command": "xiranite samea plan D:/archives/unsorted",
        "description": {
          "zh": "Preview artist archive organization.",
          "en": "Preview artist archive organization."
        },
        "examples": []
      }
    ],
    "safety": {
      "defaultMode": "dry-run",
      "destructive": {
        "zh": [
          "classify"
        ],
        "en": [
          "classify"
        ]
      },
      "notes": {
        "zh": [
          "Live classification moves archives and reports existing targets as conflicts."
        ],
        "en": [
          "Live classification moves archives and reports existing targets as conflicts."
        ]
      }
    }
  }
}
