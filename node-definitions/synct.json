{
  "definitionVersion": 1,
  "nodeId": "synct",
  "title": {
    "zh": "Synct",
    "en": "Synct"
  },
  "description": {
    "zh": "将文件或文件夹归档到按日期组织的路径。",
    "en": "Archive files or folders into date-based paths."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描",
        "en": "⌕ Scan"
      }
    },
    {
      "id": "plan",
      "label": {
        "zh": "⌁ 规划",
        "en": "⌁ Plan"
      }
    },
    {
      "id": "archive",
      "label": {
        "zh": "⇄ 归档",
        "en": "⇄ Archive"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描",
            "en": "⌕ Scan"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌁ 规划",
            "en": "⌁ Plan"
          }
        },
        {
          "value": {
            "text": "archive"
          },
          "label": {
            "zh": "⇄ 归档",
            "en": "⇄ Archive"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "来源路径",
        "en": "Source paths"
      },
      "kind": "path-list",
      "lines": 3,
      "placeholder": {
        "zh": "每行一个文件或目录",
        "en": "One file or folder per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          },
          "message": {
            "zh": "请至少输入一个来源路径。",
            "en": "Enter at least one source path."
          }
        }
      ]
    },
    {
      "id": "sourceMode",
      "label": {
        "zh": "来源类型",
        "en": "Source mode"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "files"
          },
          "label": {
            "zh": "▤ 文件",
            "en": "▤ Files"
          }
        },
        {
          "value": {
            "text": "folders"
          },
          "label": {
            "zh": "▣ 文件夹",
            "en": "▣ Folders"
          }
        }
      ],
      "default": {
        "text": "files"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "formatKey",
      "label": {
        "zh": "归档路径格式",
        "en": "Archive format"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "year"
          },
          "label": {
            "zh": "YYYY",
            "en": "YYYY"
          }
        },
        {
          "value": {
            "text": "year_month"
          },
          "label": {
            "zh": "YYYY-MM",
            "en": "YYYY-MM"
          }
        },
        {
          "value": {
            "text": "year_month_day"
          },
          "label": {
            "zh": "YYYY-MM-DD",
            "en": "YYYY-MM-DD"
          }
        },
        {
          "value": {
            "text": "month_day"
          },
          "label": {
            "zh": "MM-DD",
            "en": "MM-DD"
          }
        },
        {
          "value": {
            "text": "day"
          },
          "label": {
            "zh": "DD",
            "en": "DD"
          }
        },
        {
          "value": {
            "text": "nested_y_m"
          },
          "label": {
            "zh": "YYYY / MM",
            "en": "YYYY / MM"
          }
        },
        {
          "value": {
            "text": "nested_y_m_d"
          },
          "label": {
            "zh": "YYYY / MM / DD",
            "en": "YYYY / MM / DD"
          }
        },
        {
          "value": {
            "text": "nested_ym_d"
          },
          "label": {
            "zh": "YYYY-MM / DD",
            "en": "YYYY-MM / DD"
          }
        },
        {
          "value": {
            "text": "nested_y_md"
          },
          "label": {
            "zh": "YYYY / MM-DD",
            "en": "YYYY / MM-DD"
          }
        }
      ],
      "default": {
        "text": "year_month"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "recursive",
      "label": {
        "zh": "递归扫描",
        "en": "Recursive"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "archiveFolder",
      "label": {
        "zh": "使用 archive 子目录",
        "en": "Use archive folder"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "fallbackToCreatedTime",
      "label": {
        "zh": "回退到创建时间",
        "en": "Fallback to created time"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "syncFolderFileTimes",
      "label": {
        "zh": "同步文件夹内时间",
        "en": "Sync folder file times"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "fieldEquals",
            "fieldId": "sourceMode",
            "value": {
              "text": "folders"
            }
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预览",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "archive"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "sources",
      "title": {
        "zh": "来源与归档规则",
        "en": "Sources and archive rules"
      },
      "fieldIds": [
        "action",
        "pathsText",
        "sourceMode",
        "formatKey",
        "recursive",
        "archiveFolder",
        "fallbackToCreatedTime",
        "syncFolderFileTimes",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "lines"
    },
    {
      "fieldId": "sourceMode",
      "slot": "sourceMode",
      "transform": "trim"
    },
    {
      "fieldId": "formatKey",
      "slot": "formatKey",
      "transform": "trim"
    },
    {
      "fieldId": "recursive",
      "slot": "recursive",
      "transform": "asBoolean"
    },
    {
      "fieldId": "archiveFolder",
      "slot": "archiveFolder",
      "transform": "asBoolean"
    },
    {
      "fieldId": "fallbackToCreatedTime",
      "slot": "fallbackToCreatedTime",
      "transform": "asBoolean"
    },
    {
      "fieldId": "syncFolderFileTimes",
      "slot": "syncFolderFileTimes",
      "transform": "asBoolean"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "archive"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认移动归档项目",
      "en": "Confirm archive moves"
    },
    "body": {
      "zh": "就绪项目将被移动到按日期生成的目录。",
      "en": "Ready items will be moved into date-based directories."
    },
    "confirmLabel": {
      "zh": "确认归档",
      "en": "Archive"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "dashboard": {
    "title": {
      "zh": "Synct",
      "en": "Synct"
    },
    "primary": {
      "type": "firstNonEmpty",
      "fieldIds": [
        "pathsText"
      ],
      "fallbackText": {
        "zh": "Synct",
        "en": "Synct"
      }
    },
    "secondary": {
      "type": "field",
      "fieldId": "formatKey"
    },
    "metrics": []
  },
  "help": {
    "whenToUse": {
      "zh": [
        "当截图、下载文件或带日期的文件夹需要归入年/月/日归档目录时使用 Synct。"
      ],
      "en": [
        "Use Synct when screenshots, downloads, or dated folders need to be grouped into year/month/day archive directories."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "文件归档",
          "en": "File archive"
        },
        "summary": {
          "zh": "按文件名时间戳将文件移入日期文件夹。",
          "en": "Move files into date folders based on filename timestamps."
        },
        "ui": {
          "zh": [
            "粘贴源文件夹。",
            "选择文件模式和日期格式。",
            "归档前预览目标分布。"
          ],
          "en": [
            "Paste source folders.",
            "Select file mode and a date format.",
            "Preview target distribution before archive."
          ]
        }
      },
      {
        "title": {
          "zh": "文件夹归档",
          "en": "Folder archive"
        },
        "summary": {
          "zh": "移动带日期的文件夹，并可选同步内部文件时间。",
          "en": "Move dated folders and optionally sync internal file times."
        },
        "ui": {
          "zh": [
            "选择文件夹模式。",
            "名称不含日期时保持兜底选项开启。",
            "仅在冲突检查后再确认真实归档。"
          ],
          "en": [
            "Select folder mode.",
            "Keep fallback enabled when names do not contain dates.",
            "Confirm live archive only after conflict review."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "预览文件",
          "en": "Preview files"
        },
        "command": "xiranite synct plan D:/downloads --source-mode files --format nested_y_m",
        "description": {
          "zh": "预览文件归档目标。",
          "en": "Preview file archive destinations."
        },
        "examples": [
          {
            "label": {
              "zh": "归档文件夹",
              "en": "Archive folders"
            },
            "command": "xiranite synct archive D:/work --source-mode folders --archive-folder",
            "description": {
              "zh": "将文件夹移入本地归档目录。",
              "en": "Move folders into a local archive directory."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "dry-run",
      "destructive": {
        "zh": [
          "archive"
        ],
        "en": [
          "archive"
        ]
      },
      "notes": {
        "zh": [
          "已存在的目标会作为冲突报告并跳过。",
          "真实归档在 UI 中需经确认才会执行。"
        ],
        "en": [
          "Existing targets are reported as conflicts and skipped.",
          "Live archive is gated by confirmation in the UI."
        ]
      }
    }
  }
}
