      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract",
              "move"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "autoDir",
      "label": {
        "zh": "自动子目录",
        "en": "Automatic subdirectory"
