{
  "definitionVersion": 1,
  "nodeId": "repacku",
  "title": {
    "zh": "Repacku",
    "en": "Repacku"
  },
  "description": {
    "zh": "分析文件夹结构，并将匹配的文件夹重新打包为 zip 归档。",
    "en": "Analyze folder structures and repack matching folders into zip archives."
  },
  "actions": [
    {
      "id": "analyze",
      "label": {
        "zh": "分析",
        "en": "Analyze"
      }
    },
    {
      "id": "compress",
      "label": {
        "zh": "压缩",
        "en": "Compress"
      }
    },
    {
      "id": "full",
      "label": {
        "zh": "完整流程",
        "en": "Full flow"
      }
    },
    {
      "id": "single-pack",
      "label": {
        "zh": "单层打包",
        "en": "Single pack"
      }
    },
    {
      "id": "gallery-pack",
      "label": {
        "zh": "画集打包",
        "en": "Gallery pack"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "工作流",
        "en": "Workflow"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "analyze"
          },
          "label": {
            "zh": "分析",
            "en": "Analyze"
          }
        },
        {
          "value": {
            "text": "compress"
          },
          "label": {
            "zh": "压缩",
            "en": "Compress"
          }
        },
        {
          "value": {
            "text": "full"
          },
          "label": {
            "zh": "完整流程",
            "en": "Full flow"
          }
        },
        {
          "value": {
            "text": "single-pack"
          },
          "label": {
            "zh": "单层打包",
            "en": "Single pack"
          }
        },
        {
          "value": {
            "text": "gallery-pack"
          },
          "label": {
            "zh": "画集打包",
            "en": "Gallery pack"
          }
        }
      ],
      "default": {
        "text": "full"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "文件夹路径",
        "en": "Folder paths"
      },
      "kind": "path-list",
      "lines": 5,
      "placeholder": {
        "zh": "每行一个路径",
        "en": "One folder per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "compress"
                ]
              },
              "negated": true
            }
          }
        }
      ]
    },
    {
      "id": "types",
      "label": {
        "zh": "目标类型",
        "en": "Target types"
      },
      "kind": "text",
      "placeholder": {
        "zh": "image,document",
        "en": "image,document"
      },
      "default": {
        "text": "image"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "minCount",
      "label": {
        "zh": "最少文件数",
        "en": "Minimum files"
      },
      "kind": "number",
      "range": {
        "min": 1,
        "max": 9999,
        "step": 1
      },
      "default": {
        "number": 2
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerInRange"
          }
        }
      ]
    },
    {
      "id": "outputPath",
      "label": {
        "zh": "配置输出",
        "en": "Config output"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "configPath",
      "label": {
        "zh": "配置路径",
        "en": "Config path"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "custom",
            "exportName": "compress_needs_config_or_paths"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "compress"
                ]
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "galleryMarker",
      "label": {
        "zh": "画集标记",
        "en": "Gallery marker"
      },
      "kind": "text",
      "default": {
        "text": ". 画集"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "deleteAfter",
      "label": {
        "zh": "成功后删除源文件",
        "en": "Delete sources after success"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "预演",
        "en": "Dry-run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "delimited"
    },
    {
      "fieldId": "types",
      "slot": "types",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "minCount",
      "slot": "minCount",
      "transform": "asInteger"
    },
    {
      "fieldId": "outputPath",
      "slot": "outputPath",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "configPath",
      "slot": "configPath",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "galleryMarker",
      "slot": "galleryMarker",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "deleteAfter",
      "slot": "deleteAfter",
      "transform": "asBoolean"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "pluginExport",
    "exportName": "is_dangerous"
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认重打包",
      "en": "Confirm repacking"
    },
    "body": {
      "zh": "此操作会写入归档文件。",
      "en": "Archives will be written to disk."
    },
    "confirmLabel": {
      "zh": "确认执行",
      "en": "Run now"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "需要从工作区 UI 或 CLI 使用此节点的文件工作流时，可使用 Repacku。"
      ],
      "en": [
        "Use Repacku when you need this node's file workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 Repacku，并在节点面板中运行。",
          "en": "Deploy Repacku from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 Repacku 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，查看结果与日志后再实际应用变更。"
          ],
          "en": [
            "Open the module registry and deploy Repacku to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端中运行 Repacku。",
          "en": "Run Repacku directly from a terminal."
        },
        "cli": {
          "zh": [
            "当命令支持交互式提示时，运行 `xiranite repacku` 进入引导模式。",
            "运行 `xiranite repacku --help` 查看节点命令的具体标志与子命令。"
          ],
          "en": [
            "Run `xiranite repacku` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite repacku --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite repacku",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属标志。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite repacku",
            "description": {
              "zh": "启动节点的交互式终端工作流。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令标志",
              "en": "Command flags"
            },
            "command": "xiranite repacku --help",
            "description": {
              "zh": "查看节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help repacku",
            "description": {
              "zh": "在根 CLI 中渲染此共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "修改文件前，优先使用预览或试运行模式。",
          "处理大型文件夹时，请保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
