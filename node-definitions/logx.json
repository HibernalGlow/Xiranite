  "help": {
    "whenToUse": {
      "zh": [
        "Investigate a failed frontend or backend session.",
        "Group repeated errors by fingerprint.",
        "Validate JSONL files and retention output before sharing an incident bundle."
      ],
      "en": [
        "Investigate a failed frontend or backend session.",
        "Group repeated errors by fingerprint.",
        "Validate JSONL files and retention output before sharing an incident bundle."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "Workspace GUI",
          "en": "Workspace GUI"
        },
        "summary": {
          "zh": "Filter and inspect events without leaving Xiranite.",
          "en": "Filter and inspect events without leaving Xiranite."
        },
        "ui": {
          "zh": [
            "Deploy LogX from the module registry.",
            "Choose a severity and optional scope, session, event, time, or text filter.",
            "Run the query and select an event to inspect its resource, attributes, and error."
          ],
          "en": [
            "Deploy LogX from the module registry.",
            "Choose a severity and optional scope, session, event, time, or text filter.",
            "Run the query and select an event to inspect its resource, attributes, and error."
          ]
        },
        "tips": {
          "zh": [
            "Start with warn+, then narrow by session or scope."
          ],
          "en": [
            "Start with warn+, then narrow by session or scope."
          ]
        }
      },
      {
        "title": {
          "zh": "Terminal",
          "en": "Terminal"
        },
        "summary": {
          "zh": "Use direct commands, guided mode, or OpenTUI.",
          "en": "Use direct commands, guided mode, or OpenTUI."
        },
        "cli": {
          "zh": [
            "Run `xlogx query --level warn` for scripts.",
            "Run `xlogx` for guided mode or `xlogx ui` for OpenTUI.",
            "Use `xlogx doctor` to validate all discovered files."
          ],
          "en": [
            "Run `xlogx query --level warn` for scripts.",
            "Run `xlogx` for guided mode or `xlogx ui` for OpenTUI.",
            "Use `xlogx doctor` to validate all discovered files."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "Analyze logs",
          "en": "Analyze logs"
        },
        "command": "xlogx",
        "description": {
          "zh": "Query events, sessions, statistics, errors, or integrity.",
          "en": "Query events, sessions, statistics, errors, or integrity."
        },
        "examples": [
          {
            "label": {
              "zh": "OpenTUI",
              "en": "OpenTUI"
            },
            "command": "xlogx ui",
            "description": {
              "zh": "Open the fullscreen LogX workbench.",
              "en": "Open the fullscreen LogX workbench."
            }
          },
          {
            "label": {
              "zh": "Errors",
              "en": "Errors"
            },
            "command": "xlogx errors --level error",
            "description": {
              "zh": "Group error fingerprints.",
              "en": "Group error fingerprints."
            }
          },
          {
            "label": {
              "zh": "Scoped query",
              "en": "Scoped query"
            },
            "command": "xlogx query --scope neoview --search decode --json",
            "description": {
              "zh": "Return matching envelopes as JSON.",
              "en": "Return matching envelopes as JSON."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "read-only",
      "notes": {
        "zh": [
          "LogX never mutates source logs.",
          "Exported events retain their original structured envelope."
        ],
        "en": [
          "LogX never mutates source logs.",
          "Exported events retain their original structured envelope."
        ]
      }
    }
  }
