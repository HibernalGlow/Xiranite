{
  "definitionVersion": 1,
  "nodeId": "mvz",
  "title": {
    "zh": "MVZ",
    "en": "MVZ"
  },
  "description": {
    "zh": "根据 findz 输出，对归档内的文件执行删除、解压、移动或重命名。",
    "en": "Delete, extract, move, or rename files inside archives from findz output."
  },
  "actions": [
    {
      "id": "extract",
      "label": {
        "zh": "⇩ 解压",
        "en": "⇩ Extract"
      }
    },
    {
      "id": "move",
      "label": {
        "zh": "⇄ 移动",
        "en": "⇄ Move"
      }
    },
    {
      "id": "delete",
      "label": {
        "zh": "⌫ 删除",
        "en": "⌫ Delete"
      }
    },
    {
      "id": "rename",
      "label": {
        "zh": "✎ 重命名",
        "en": "✎ Rename"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "extract"
          },
          "label": {
            "zh": "⇩ 解压",
            "en": "⇩ Extract"
          }
        },
        {
          "value": {
            "text": "move"
          },
          "label": {
            "zh": "⇄ 移动",
            "en": "⇄ Move"
          }
        },
        {
          "value": {
            "text": "delete"
          },
          "label": {
            "zh": "⌫ 删除",
            "en": "⌫ Delete"
          }
        },
        {
          "value": {
            "text": "rename"
          },
          "label": {
            "zh": "✎ 重命名",
            "en": "✎ Rename"
          }
        }
      ],
      "default": {
        "text": "extract"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "fileText",
      "label": {
        "zh": "归档内部条目",
        "en": "Archive entries"
      },
      "kind": "multiline",
      "lines": 5,
      "placeholder": {
        "zh": "D:/archive.zip//internal/file.txt",
        "en": "D:/archive.zip//internal/file.txt"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
          }
        }
      ]
    },
    {
      "id": "output",
      "label": {
        "zh": "输出目录",
        "en": "Output directory"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract",
              "move"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "near",
      "label": {
        "zh": "就近输出",
        "en": "Near archive"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract",
              "move"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "autoDir",
      "label": {
        "zh": "自动子目录",
        "en": "Automatic subdirectory"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract",
              "move"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "flatten",
      "label": {
        "zh": "扁平提取",
        "en": "Flatten"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "extract",
              "move"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "pattern",
      "label": {
        "zh": "匹配表达式",
        "en": "Rename pattern"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "rename"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "rename"
                ]
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "replacement",
      "label": {
        "zh": "替换文本",
        "en": "Replacement"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "rename"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "separator",
      "label": {
        "zh": "路径分隔符",
        "en": "Entry separator"
      },
      "kind": "text",
      "default": {
        "text": "//"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "archive",
      "title": {
        "zh": "归档操作",
        "en": "Archive operation"
      },
      "fieldIds": [
        "action",
        "fileText",
        "output",
        "near",
        "autoDir",
        "flatten",
        "pattern",
        "replacement",
        "separator",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "fileText",
      "slot": "fileText",
      "transform": "identity"
    },
    {
      "fieldId": "output",
      "slot": "output",
      "transform": "identity"
    },
    {
      "fieldId": "near",
      "slot": "near",
      "transform": "asBoolean"
    },
    {
      "fieldId": "autoDir",
      "slot": "autoDir",
      "transform": "asBoolean"
    },
    {
      "fieldId": "flatten",
      "slot": "flatten",
      "transform": "asBoolean"
    },
    {
      "fieldId": "pattern",
      "slot": "pattern",
      "transform": "identity"
    },
    {
      "fieldId": "replacement",
      "slot": "replacement",
      "transform": "identity"
    },
    {
      "fieldId": "separator",
      "slot": "separator",
      "transform": "identity"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "fieldFlag",
    "fieldId": "dryRun",
    "inverted": true
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认修改压缩包",
      "en": "Confirm archive modification"
    },
    "body": {
      "zh": "此操作会修改压缩包内容。",
      "en": "This modifies archive contents."
    },
    "confirmLabel": {
      "zh": "确认执行",
      "en": "Execute"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "当需要从工作区 UI 或 CLI 使用该节点的文件工作流时，使用 MVZ。"
      ],
      "en": [
        "Use MVZ when you need this node's file workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 MVZ，并在节点面板上运行。",
          "en": "Deploy MVZ from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 MVZ 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "运行预览或主操作，查看结果与日志后再应用真实变更。"
          ],
          "en": [
            "Open the module registry and deploy MVZ to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端运行 MVZ。",
          "en": "Run MVZ directly from a terminal."
        },
        "cli": {
          "zh": [
            "命令支持交互式提示时，运行 `xiranite mvz` 进入引导模式。",
            "运行 `xiranite mvz --help` 查看该节点命令的完整参数与子命令。"
          ],
          "en": [
            "Run `xiranite mvz` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite mvz --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite mvz",
        "description": {
          "zh": "打开节点 CLI，或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite mvz",
            "description": {
              "zh": "启动该节点的交互式终端工作流。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite mvz --help",
            "description": {
              "zh": "显示节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help mvz",
            "description": {
              "zh": "在根 CLI 中渲染这条共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "修改文件前优先使用预览或 dry-run 模式。",
          "处理大文件夹时保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
