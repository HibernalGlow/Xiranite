{
  "$schema": "https://schema.tauri.app/config/3",
  "productName": "Xiranite",
  "version": "0.1.0",
  "identifier": "app.xiranite.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../dist",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Xiranite",
        "width": 1180,
        "height": 760,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
