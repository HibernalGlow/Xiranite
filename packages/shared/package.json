{
  "name": "@xiranite/shared",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "description": "Shared DTOs and schemas for Xiranite services.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./swimlane": {
      "types": "./dist/swimlane.d.ts",
      "default": "./dist/swimlane.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "default": "./dist/rules.js"
    },
    "./rules-engine": {
      "types": "./dist/rules-engine.d.ts",
      "default": "./dist/rules-engine.js"
    },
    "./efu": {
      "types": "./dist/efu.d.ts",
      "default": "./dist/efu.js"
    },
    "./efu-stream": {
      "types": "./dist/efu-stream.d.ts",
      "default": "./dist/efu-stream.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:tsc": "tsc -p tsconfig.json",
    "test": "bun run build"
  },
  "dependencies": {
    "csv-parse": "^7.0.1",
    "json-rules-engine": "7.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
