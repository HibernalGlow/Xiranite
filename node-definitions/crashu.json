{
  "definitionVersion": 1,
  "nodeId": "crashu",
  "title": {
    "zh": "Crashu",
    "en": "Crashu"
  },
  "description": {
    "zh": "匹配相似文件夹名称，并可选地移动匹配到的文件夹。",
    "en": "Match similar folder names and optionally move matched folders."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描",
        "en": "⌕ Scan"
      }
    },
    {
      "id": "plan",
      "label": {
        "zh": "⌁ 规划",
        "en": "⌁ Plan"
      }
    },
    {
      "id": "move",
      "label": {
        "zh": "⇄ 移动",
        "en": "⇄ Move"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描",
            "en": "⌕ Scan"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌁ 规划",
            "en": "⌁ Plan"
          }
        },
        {
          "value": {
            "text": "move"
          },
          "label": {
            "zh": "⇄ 移动",
            "en": "⇄ Move"
          }
        }
      ],
      "default": {
        "text": "scan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "sourcePaths",
      "label": {
        "zh": "来源目录",
        "en": "Source directories"
      },
      "kind": "path-list",
      "lines": 3,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "targetPath",
      "label": {
        "zh": "目标目录",
        "en": "Target directory"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "custom",
            "exportName": "target_dir_or_names_required"
          }
        }
      ]
    },
    {
      "id": "targetNames",
      "label": {
        "zh": "目标名称（可选）",
        "en": "Target names"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "destinationPath",
      "label": {
        "zh": "移动目标根目录",
        "en": "Move destination"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "similarityThreshold",
      "label": {
        "zh": "相似度阈值",
        "en": "Similarity threshold"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 1,
        "step": 0.05
      },
      "default": {
        "number": 0.65
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "moveDirection",
      "label": {
        "zh": "移动方向",
        "en": "Move direction"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "to_target"
          },
          "label": {
            "zh": "来源 → 目标",
            "en": "Source → target"
          }
        },
        {
          "value": {
            "text": "to_source"
          },
          "label": {
            "zh": "目标 → 来源",
            "en": "Target → source"
          }
        }
      ],
      "default": {
        "text": "to_target"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "conflictPolicy",
      "label": {
        "zh": "冲突策略",
        "en": "Conflict policy"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "skip"
          },
          "label": {
            "zh": "跳过",
            "en": "Skip"
          }
        },
        {
          "value": {
            "text": "rename"
          },
          "label": {
            "zh": "改名",
            "en": "Rename"
          }
        },
        {
          "value": {
            "text": "overwrite"
          },
          "label": {
            "zh": "覆盖",
            "en": "Overwrite"
          }
        }
      ],
      "default": {
        "text": "skip"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "pairsFileName",
      "label": {
        "zh": "配对记录文件",
        "en": "Pairs file"
      },
      "kind": "text",
      "default": {
        "text": "folder_pairs.json"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "move"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "collision",
      "title": {
        "zh": "碰撞解析",
        "en": "Collision resolver"
      },
      "fieldIds": [
        "action",
        "sourcePaths",
        "targetPath",
        "targetNames",
        "destinationPath",
        "similarityThreshold",
        "moveDirection",
        "conflictPolicy",
        "pairsFileName",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "sourcePaths",
      "slot": "sourcePaths",
      "transform": "lines"
    },
    {
      "fieldId": "targetPath",
      "slot": "targetPath",
      "transform": "identity"
    },
    {
      "fieldId": "targetNames",
      "slot": "targetNames",
      "transform": "delimited"
    },
    {
      "fieldId": "destinationPath",
      "slot": "destinationPath",
      "transform": "identity"
    },
    {
      "fieldId": "similarityThreshold",
      "slot": "similarityThreshold",
      "transform": "identity"
    },
    {
      "fieldId": "moveDirection",
      "slot": "moveDirection",
      "transform": "trim"
    },
    {
      "fieldId": "conflictPolicy",
      "slot": "conflictPolicy",
      "transform": "trim"
    },
    {
      "fieldId": "pairsFileName",
      "slot": "pairsFileName",
      "transform": "identity"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "move"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认执行目录移动",
      "en": "Confirm folder moves"
    },
    "body": {
      "zh": "匹配目录将按冲突策略移动，覆盖无法撤销。",
      "en": "Matched folders will be moved using the conflict policy."
    },
    "confirmLabel": {
      "zh": "确认移动",
      "en": "Move"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "需要从工作区 UI 或 CLI 使用本节点的文件处理流程时使用 Crashu。"
      ],
      "en": [
        "Use Crashu when you need this node's file workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 Crashu，并在节点面板上运行。",
          "en": "Deploy Crashu from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 Crashu 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，查看结果与日志后再应用真实变更。"
          ],
          "en": [
            "Open the module registry and deploy Crashu to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端运行 Crashu。",
          "en": "Run Crashu directly from a terminal."
        },
        "cli": {
          "zh": [
            "运行 `xiranite crashu` 进入引导模式（当命令支持交互式提示时）。",
            "运行 `xiranite crashu --help` 查看该节点命令的具体参数与子命令。"
          ],
          "en": [
            "Run `xiranite crashu` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite crashu --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite crashu",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite crashu",
            "description": {
              "zh": "启动该节点的交互式终端流程。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite crashu --help",
            "description": {
              "zh": "查看该节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help crashu",
            "description": {
              "zh": "在根 CLI 中渲染本条共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "改动文件前优先使用预览或 dry-run 模式。",
          "处理大型文件夹时请保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
