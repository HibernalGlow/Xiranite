{
  "definitionVersion": 1,
  "nodeId": "migratef",
  "title": {
    "zh": "MigrateF",
    "en": "MigrateF"
  },
  "description": {
    "zh": "以 preserve、flat、direct 三种模式移动或复制文件，并提供撤销历史。",
    "en": "Move or copy files with preserve, flat, and direct modes plus undo history."
  },
  "actions": [
    {
      "id": "plan",
      "label": {
        "zh": "⌁ 迁移计划",
        "en": "⌁ Plan"
      }
    },
    {
      "id": "move",
      "label": {
        "zh": "→ 移动",
        "en": "→ Move"
      }
    },
    {
      "id": "copy",
      "label": {
        "zh": "⧉ 复制",
        "en": "⧉ Copy"
      }
    },
    {
      "id": "history",
      "label": {
        "zh": "◷ 历史",
        "en": "◷ History"
      }
    },
    {
      "id": "undo",
      "label": {
        "zh": "↶ 撤销",
        "en": "↶ Undo"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌁ 迁移计划",
            "en": "⌁ Plan"
          }
        },
        {
          "value": {
            "text": "move"
          },
          "label": {
            "zh": "→ 移动",
            "en": "→ Move"
          }
        },
        {
          "value": {
            "text": "copy"
          },
          "label": {
            "zh": "⧉ 复制",
            "en": "⧉ Copy"
          }
        },
        {
          "value": {
            "text": "history"
          },
          "label": {
            "zh": "◷ 历史",
            "en": "◷ History"
          }
        },
        {
          "value": {
            "text": "undo"
          },
          "label": {
            "zh": "↶ 撤销",
            "en": "↶ Undo"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "mode",
      "label": {
        "zh": "目录模式",
        "en": "Layout mode"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "preserve"
          },
          "label": {
            "zh": "▦ 保留结构",
            "en": "▦ Preserve"
          }
        },
        {
          "value": {
            "text": "flat"
          },
          "label": {
            "zh": "═ 扁平化",
            "en": "═ Flat"
          }
        },
        {
          "value": {
            "text": "direct"
          },
          "label": {
            "zh": "→ 直接迁移",
            "en": "→ Direct"
          }
        }
      ],
      "default": {
        "text": "preserve"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "history",
              "undo"
            ]
          },
          "negated": true
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history",
                  "undo"
                ]
              },
              "negated": true
            }
          }
        }
      ]
    },
    {
      "id": "sourcePaths",
      "label": {
        "zh": "来源路径",
        "en": "Source paths"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "history",
              "undo"
            ]
          },
          "negated": true
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history",
                  "undo"
                ]
              },
              "negated": true
            }
          }
        }
      ]
    },
    {
      "id": "targetPath",
      "label": {
        "zh": "目标目录",
        "en": "Target path"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "history",
              "undo"
            ]
          },
          "negated": true
        }
      },
      "rules": [
        {
          "rule": {
            "type": "required"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history",
                  "undo"
                ]
              },
              "negated": true
            }
          }
        },
        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history",
                  "undo"
                ]
              },
              "negated": true
            }
          }
        }
      ]
    },
    {
      "id": "maxWorkers",
      "label": {
        "zh": "并发数",
        "en": "Workers"
      },
      "kind": "number",
      "range": {
        "min": 1,
        "max": 64,
        "step": 1
      },
      "default": {
        "number": 16
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "history",
              "undo"
            ]
          },
          "negated": true
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerInRange"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "history",
                  "undo"
                ]
              },
              "negated": true
            }
          }
        }
      ]
    },
    {
      "id": "batchId",
      "label": {
        "zh": "批次 ID",
        "en": "Batch ID"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "undo"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "historyLimit",
      "label": {
        "zh": "历史条数",
        "en": "History limit"
      },
      "kind": "number",
      "range": {
        "min": 1,
        "max": 100,
        "step": 1
      },
      "default": {
        "number": 10
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "history"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerInRange"
          }
        }
      ]
    },
    {
      "id": "historyPath",
      "label": {
        "zh": "历史文件",
        "en": "History file"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "history",
              "undo"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "history"
            ]
          },
          "negated": true
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "migration",
      "title": {
        "zh": "迁移配置",
        "en": "Migration"
      },
      "fieldIds": [
        "action",
        "mode",
        "sourcePaths",
        "targetPath",
        "maxWorkers",
        "batchId",
        "historyLimit",
        "historyPath",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "mode",
      "slot": "mode",
      "transform": "trim"
    },
    {
      "fieldId": "sourcePaths",
      "slot": "sourcePaths",
      "transform": "delimited"
    },
    {
      "fieldId": "targetPath",
      "slot": "targetPath",
      "transform": "identity"
    },
    {
      "fieldId": "maxWorkers",
      "slot": "maxWorkers",
      "transform": "asInteger"
    },
    {
      "fieldId": "batchId",
      "slot": "batchId",
      "transform": "identity"
    },
    {
      "fieldId": "historyLimit",
      "slot": "historyLimit",
      "transform": "asInteger"
    },
    {
      "fieldId": "historyPath",
      "slot": "historyPath",
      "transform": "identity"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "pluginExport",
    "exportName": "is_dangerous"
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认真实迁移",
      "en": "Confirm live migration"
    },
    "body": {
      "zh": "文件系统将被真实修改。",
      "en": "The filesystem will be modified."
    },
    "confirmLabel": {
      "zh": "确认执行",
      "en": "Execute"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "dashboard": {
    "title": {
      "zh": "MigrateF",
      "en": "MigrateF"
    },
    "primary": {
      "type": "firstNonEmpty",
      "fieldIds": [
        "targetPath",
        "batchId"
      ],
      "fallbackText": {
        "zh": "MigrateF",
        "en": "MigrateF"
      }
    },
    "secondary": {
      "type": "field",
      "fieldId": "action"
    },
    "metrics": []
  },
  "help": {
    "whenToUse": {
      "zh": [
        "当需要从工作区 UI 或 CLI 使用该节点的文件工作流时，使用 MigrateF。"
      ],
      "en": [
        "Use MigrateF when you need this node's file workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 MigrateF，并在节点面板上运行。",
          "en": "Deploy MigrateF from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 MigrateF 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "运行预览或主操作，查看结果与日志后再应用真实变更。"
          ],
          "en": [
            "Open the module registry and deploy MigrateF to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端运行 MigrateF。",
          "en": "Run MigrateF directly from a terminal."
        },
        "cli": {
          "zh": [
            "命令支持交互式提示时，运行 `xiranite migratef` 进入引导模式。",
            "运行 `xiranite migratef --help` 查看该节点命令的完整参数与子命令。"
          ],
          "en": [
            "Run `xiranite migratef` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite migratef --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite migratef",
        "description": {
          "zh": "打开节点 CLI，或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite migratef",
            "description": {
              "zh": "启动该节点的交互式终端工作流。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite migratef --help",
            "description": {
              "zh": "显示节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help migratef",
            "description": {
              "zh": "在根 CLI 中渲染这条共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "修改文件前优先使用预览或 dry-run 模式。",
          "处理大文件夹时保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
