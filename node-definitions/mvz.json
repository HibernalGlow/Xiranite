          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "rename"
                ]
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "replacement",
      "label": {
        "zh": "替换文本",
        "en": "Replacement"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "rename"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "separator",
      "label": {
        "zh": "路径分隔符",
        "en": "Entry separator"
      },
      "kind": "text",
      "default": {
        "text": "//"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "archive",
      "title": {
        "zh": "归档操作",
        "en": "Archive operation"
      },
      "fieldIds": [
        "action",
        "fileText",
        "output",
        "near",
        "autoDir",
        "flatten",
        "pattern",
        "replacement",
        "separator",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "fileText",
      "slot": "fileText",
      "transform": "identity"
    },
    {
      "fieldId": "output",
      "slot": "output",
      "transform": "identity"
    },
    {
      "fieldId": "near",
      "slot": "near",
      "transform": "asBoolean"
    },
    {
      "fieldId": "autoDir",
      "slot": "autoDir",
      "transform": "asBoolean"
    },
    {
      "fieldId": "flatten",
      "slot": "flatten",
      "transform": "asBoolean"
    },
    {
      "fieldId": "pattern",
      "slot": "pattern",
      "transform": "identity"
    },
    {
      "fieldId": "replacement",
      "slot": "replacement",
      "transform": "identity"
    },
    {
      "fieldId": "separator",
      "slot": "separator",
