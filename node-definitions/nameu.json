{
  "definitionVersion": 1,
  "nodeId": "nameu",
  "title": {
    "zh": "NameU",
    "en": "NameU"
  },
  "description": {
    "zh": "为画师文件夹预览并执行归档文件名清理。",
    "en": "Preview and apply archive filename cleanup for artist folders."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌕ 扫描",
        "en": "⌕ Scan"
      }
    },
    {
      "id": "plan",
      "label": {
        "zh": "⌁ 预览",
        "en": "⌁ Preview"
      }
    },
    {
      "id": "rename",
      "label": {
        "zh": "⇄ 改名",
        "en": "⇄ Rename"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "命令",
        "en": "Command"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌕ 扫描",
            "en": "⌕ Scan"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌁ 预览",
            "en": "⌁ Preview"
          }
        },
        {
          "value": {
            "text": "rename"
          },
          "label": {
            "zh": "⇄ 改名",
            "en": "⇄ Rename"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "目录路径",
        "en": "Folder paths"
      },
      "kind": "path-list",
      "lines": 3,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "mode",
      "label": {
        "zh": "目录模式",
        "en": "Folder mode"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "multi"
          },
          "label": {
            "zh": "▦ 多作者",
            "en": "▦ Multi artist"
          }
        },
        {
          "value": {
            "text": "single"
          },
          "label": {
            "zh": "▤ 单作者",
            "en": "▤ Single artist"
          }
        }
      ],
      "default": {
        "text": "multi"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "recursive",
      "label": {
        "zh": "递归",
        "en": "Recursive"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "addArtistName",
      "label": {
        "zh": "补作者名",
        "en": "Add artist"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "normalizeFolders",
      "label": {
        "zh": "整理目录",
        "en": "Normalize folders"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "keepTimestamp",
      "label": {
        "zh": "保留时间",
        "en": "Keep timestamps"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "excludeKeywords",
      "label": {
        "zh": "排除关键词",
        "en": "Exclude keywords"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "forbiddenArtistKeywords",
      "label": {
        "zh": "禁用作者关键词",
        "en": "Forbidden artist keywords"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "archiveExtensions",
      "label": {
        "zh": "归档扩展名",
        "en": "Archive extensions"
      },
      "kind": "text",
      "default": {
        "text": ".zip,.rar,.7z,.cbz,.cbr"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "rename"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "rules",
      "title": {
        "zh": "命名规则",
        "en": "Naming rules"
      },
      "fieldIds": [
        "action",
        "pathsText",
        "mode",
        "recursive",
        "addArtistName",
        "normalizeFolders",
        "keepTimestamp",
        "excludeKeywords",
        "forbiddenArtistKeywords",
        "archiveExtensions",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "lines"
    },
    {
      "fieldId": "mode",
      "slot": "mode",
      "transform": "trim"
    },
    {
      "fieldId": "recursive",
      "slot": "recursive",
      "transform": "asBoolean"
    },
    {
      "fieldId": "addArtistName",
      "slot": "addArtistName",
      "transform": "asBoolean"
    },
    {
      "fieldId": "normalizeFolders",
      "slot": "normalizeFolders",
      "transform": "asBoolean"
    },
    {
      "fieldId": "keepTimestamp",
      "slot": "keepTimestamp",
      "transform": "asBoolean"
    },
    {
      "fieldId": "excludeKeywords",
      "slot": "excludeKeywords",
      "transform": "delimited"
    },
    {
      "fieldId": "forbiddenArtistKeywords",
      "slot": "forbiddenArtistKeywords",
      "transform": "delimited"
    },
    {
      "fieldId": "archiveExtensions",
      "slot": "archiveExtensions",
      "transform": "delimited"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "rename"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认批量改名",
      "en": "Confirm batch rename"
    },
    "body": {
      "zh": "就绪项目将被重命名；冲突项目不会执行。",
      "en": "Ready items will be renamed; conflicts stay untouched."
    },
    "confirmLabel": {
      "zh": "确认改名",
      "en": "Rename"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "归档文件名在长期保存前需要统一括号、空格、活动标签和画师后缀时，使用 NameU。"
      ],
      "en": [
        "Use NameU when archive filenames need consistent brackets, spacing, event tags, and artist suffixes before long-term storage."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "预览",
          "en": "Preview"
        },
        "summary": {
          "zh": "生成重命名计划，不修改文件。",
          "en": "Build a rename plan without changing files."
        },
        "ui": {
          "zh": [
            "粘贴一个库根目录或一个画师文件夹。",
            "选择多文件夹或单文件夹模式。",
            "应用前查看 ready、unchanged、skipped 和 conflict 各行。"
          ],
          "en": [
            "Paste one library root or one artist folder.",
            "Choose multi-folder or single-folder mode.",
            "Review ready, unchanged, skipped, and conflict rows before applying."
          ]
        }
      },
      {
        "title": {
          "zh": "应用",
          "en": "Apply"
        },
        "summary": {
          "zh": "将同一计划作为原生文件系统重命名执行。",
          "en": "Run the same plan as a native filesystem rename."
        },
        "ui": {
          "zh": [
            "计划确认无误前保持 dry-run 开启。",
            "关闭 dry-run 并确认重命名动作。",
            "执行后检查冲突与错误。"
          ],
          "en": [
            "Keep dry-run on until the plan looks correct.",
            "Turn dry-run off and confirm the rename action.",
            "Check conflicts and errors after execution."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "预览库",
          "en": "Preview library"
        },
        "command": "xiranite nameu plan D:/archives --mode multi",
        "description": {
          "zh": "预览库根目录下的所有画师文件夹。",
          "en": "Preview all artist folders under a library root."
        },
        "examples": [
          {
            "label": {
              "zh": "单个画师文件夹",
              "en": "Single artist folder"
            },
            "command": "xiranite nameu plan D:/archives/Artist --mode single",
            "description": {
              "zh": "预览单个画师文件夹。",
              "en": "Preview one artist folder."
            }
          },
          {
            "label": {
              "zh": "应用重命名",
              "en": "Apply rename"
            },
            "command": "xiranite nameu rename D:/archives --mode multi --no-artist",
            "description": {
              "zh": "执行真实重命名计划，且不追加画师名。",
              "en": "Apply a live rename plan without appending artist names."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "dry-run",
      "destructive": {
        "zh": [
          "rename"
        ],
        "en": [
          "rename"
        ]
      },
      "notes": {
        "zh": [
          "UI 中的真实重命名需要二次确认。",
          "冲突的目标名会被上报，不执行重命名。",
          "该原生节点不会调用 Python 工具的归档 ID 数据库/评论支持。"
        ],
        "en": [
          "Live rename is gated by confirmation in the UI.",
          "Conflicting target names are reported and not renamed.",
          "Archive ID database/comment support from the Python tool is not invoked by this native node."
        ]
      }
    }
  }
}
