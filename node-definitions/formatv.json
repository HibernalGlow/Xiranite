{
  "definitionVersion": 1,
  "nodeId": "formatv",
  "title": {
    "zh": "FormatV",
    "en": "FormatV"
  },
  "description": {
    "zh": "扫描视频文件夹，添加/移除 .nov 后缀，并检查带前缀的重复项。",
    "en": "Scan video folders, add/remove .nov suffixes, and check prefixed duplicates."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "扫描",
        "en": "Scan"
      }
    },
    {
      "id": "add_nov",
      "label": {
        "zh": "添加 .nov",
        "en": "Add .nov"
      }
    },
    {
      "id": "remove_nov",
      "label": {
        "zh": "移除 .nov",
        "en": "Remove .nov"
      }
    },
    {
      "id": "check_duplicates",
      "label": {
        "zh": "检查重复",
        "en": "Duplicates"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "扫描",
            "en": "Scan"
          }
        },
        {
          "value": {
            "text": "add_nov"
          },
          "label": {
            "zh": "添加 .nov",
            "en": "Add .nov"
          }
        },
        {
          "value": {
            "text": "remove_nov"
          },
          "label": {
            "zh": "移除 .nov",
            "en": "Remove .nov"
          }
        },
        {
          "value": {
            "text": "check_duplicates"
          },
          "label": {
            "zh": "检查重复",
            "en": "Duplicates"
          }
        }
      ],
      "default": {
        "text": "scan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "视频路径",
        "en": "Video paths"
      },
      "kind": "path-list",
      "lines": 5,
      "placeholder": {
        "zh": "每行一个文件夹或文件",
        "en": "One folder or file per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "recursive",
      "label": {
        "zh": "递归扫描",
        "en": "Recursive scan"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "prefixName",
      "label": {
        "zh": "前缀名称",
        "en": "Prefix name"
      },
      "kind": "text",
      "default": {
        "text": "hb"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "reportPath",
      "label": {
        "zh": "重复报告路径",
        "en": "Duplicate report path"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "预演",
        "en": "Dry-run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "delimited"
    },
    {
      "fieldId": "recursive",
      "slot": "recursive",
      "transform": "asBoolean"
    },
    {
      "fieldId": "prefixName",
      "slot": "prefixName",
      "transform": "trim"
    },
    {
      "fieldId": "reportPath",
      "slot": "reportPath",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "add_nov",
            "remove_nov"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认重命名",
      "en": "Confirm rename"
    },
    "body": {
      "zh": "将执行添加/移除 .nov 后缀。",
      "en": "Files will be renamed to add/remove the .nov suffix."
    },
    "confirmLabel": {
      "zh": "确认执行",
      "en": "Run now"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "resultTable": {
    "columns": [
      {
        "id": "sourcePath",
        "label": {
          "zh": "来源",
          "en": "Source"
        },
        "width": 40
      },
      {
        "id": "targetPath",
        "label": {
          "zh": "目标",
          "en": "Target"
        },
        "width": 40
      },
      {
        "id": "status",
        "label": {
          "zh": "状态",
          "en": "Status"
        },
        "width": 12
      }
    ]
  },
  "help": {
    "whenToUse": {
      "zh": [
        "需要在工作区 UI 或 CLI 中使用该节点的视频工作流时，使用 FormatV。"
      ],
      "en": [
        "Use FormatV when you need this node's video workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 FormatV，并在节点面板上运行。",
          "en": "Deploy FormatV from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 FormatV 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，再检查结果与日志，最后才应用真实变更。"
          ],
          "en": [
            "Open the module registry and deploy FormatV to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接从终端运行 FormatV。",
          "en": "Run FormatV directly from a terminal."
        },
        "cli": {
          "zh": [
            "命令支持交互提示时，运行 `xiranite formatv` 进入引导模式。",
            "运行 `xiranite formatv --help` 查看该节点命令的具体参数与子命令。"
          ],
          "en": [
            "Run `xiranite formatv` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite formatv --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite formatv",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属参数。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite formatv",
            "description": {
              "zh": "启动该节点的交互式终端流程。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令参数",
              "en": "Command flags"
            },
            "command": "xiranite formatv --help",
            "description": {
              "zh": "显示该节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help formatv",
            "description": {
              "zh": "在根 CLI 中渲染该共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "在修改文件前，优先使用预览或 dry-run 模式。",
          "处理大文件夹时请保留备份或撤销记录。"
        ],
        "en": [
          "Prefer preview or dry-run modes before changing files.",
          "Keep backups or undo records when processing large folders."
        ]
      }
    }
  }
}
