{
  "definitionVersion": 1,
  "nodeId": "sleept",
  "title": {
    "zh": "Sleept",
    "en": "Sleept"
  },
  "description": {
    "zh": "系统计时器，支持倒计时、定时、网络和 CPU 触发。",
    "en": "System timer for countdown, scheduled time, network, and CPU triggers."
  },
  "actions": [
    {
      "id": "countdown",
      "label": {
        "zh": "倒计时",
        "en": "Countdown"
      }
    },
    {
      "id": "specific_time",
      "label": {
        "zh": "定时",
        "en": "At"
      }
    },
    {
      "id": "netspeed",
      "label": {
        "zh": "网络",
        "en": "Net"
      }
    },
    {
      "id": "cpu",
      "label": {
        "zh": "CPU",
        "en": "CPU"
      }
    },
    {
      "id": "get_stats",
      "label": {
        "zh": "当前状态",
        "en": "Current status"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "定时模式",
        "en": "Timer mode"
      },
      "description": {
        "zh": "选择计时、监控或状态工作流。",
        "en": "Select a timer, monitor, or status workflow."
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "countdown"
          },
          "label": {
            "zh": "倒计时",
            "en": "Countdown"
          }
        },
        {
          "value": {
            "text": "specific_time"
          },
          "label": {
            "zh": "定时",
            "en": "At"
          }
        },
        {
          "value": {
            "text": "netspeed"
          },
          "label": {
            "zh": "网络",
            "en": "Net"
          }
        },
        {
          "value": {
            "text": "cpu"
          },
          "label": {
            "zh": "CPU",
            "en": "CPU"
          }
        },
        {
          "value": {
            "text": "get_stats"
          },
          "label": {
            "zh": "当前状态",
            "en": "Current status"
          }
        }
      ],
      "default": {
        "text": "countdown"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "hours",
      "label": {
        "zh": "小时",
        "en": "hours"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 23,
        "step": 1
      },
      "default": {
        "number": 0
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "countdown"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerAtLeast",
            "minimum": 0
          }
        },
        {
          "rule": {
            "type": "custom",
            "exportName": "countdown_duration_positive"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "countdown"
                ]
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "minutes",
      "label": {
        "zh": "分钟",
        "en": "minutes"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 59,
        "step": 1
      },
      "default": {
        "number": 0
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "countdown"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerAtLeast",
            "minimum": 0
          }
        }
      ]
    },
    {
      "id": "seconds",
      "label": {
        "zh": "秒",
        "en": "seconds"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "max": 59,
        "step": 1
      },
      "default": {
        "number": 5
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "countdown"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerAtLeast",
            "minimum": 0
          }
        }
      ]
    },
    {
      "id": "targetDatetime",
      "label": {
        "zh": "目标时间",
        "en": "target datetime"
      },
      "kind": "text",
      "placeholder": {
        "zh": "YYYY-MM-DD HH:MM:SS",
        "en": "YYYY-MM-DD HH:MM:SS"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "specific_time"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "custom",
            "exportName": "target_datetime_parsable"
          }
        }
      ]
    },
    {
      "id": "uploadThreshold",
      "label": {
        "zh": "上传阈值（KB/s）",
        "en": "Upload threshold (KB/s)"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "step": 1
      },
      "default": {
        "number": 242
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "netspeed"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerAtLeast",
            "minimum": 0
          }
        }
      ]
    },
    {
      "id": "downloadThreshold",
      "label": {
        "zh": "下载阈值（KB/s）",
        "en": "Download threshold (KB/s)"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "step": 1
      },
      "default": {
        "number": 242
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "netspeed"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerAtLeast",
            "minimum": 0
          }
        }
      ]
    },
    {
      "id": "netDuration",
      "label": {
        "zh": "持续时长（分钟）",
        "en": "Sustained duration (minutes)"
      },
      "kind": "number",
      "range": {
        "min": 0.5,
        "step": 0.5
      },
      "default": {
        "number": 2
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "netspeed"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "netTriggerMode",
      "label": {
        "zh": "网络触发条件",
        "en": "Network trigger"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "both"
          },
          "label": {
            "zh": "上传和下载都低于阈值",
            "en": "Both below threshold"
          }
        },
        {
          "value": {
            "text": "any"
          },
          "label": {
            "zh": "任意一个低于阈值",
            "en": "Either below threshold"
          }
        }
      ],
      "default": {
        "text": "both"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "netspeed"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "cpuThreshold",
      "label": {
        "zh": "阈值 %",
        "en": "threshold %"
      },
      "kind": "number",
      "range": {
        "min": 1,
        "max": 100,
        "step": 1
      },
      "default": {
        "number": 10
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "cpu"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerAtLeast",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "cpuDuration",
      "label": {
        "zh": "持续时长（分钟）",
        "en": "Sustained duration (minutes)"
      },
      "kind": "number",
      "range": {
        "min": 0.5,
        "step": 0.5
      },
      "default": {
        "number": 2
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "cpu"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "maxWaitSeconds",
      "label": {
        "zh": "最长等待秒数（0 表示无限）",
        "en": "Maximum wait (seconds; 0 is unlimited)"
      },
      "kind": "number",
      "range": {
        "min": 0,
        "step": 1
      },
      "default": {
        "number": 3600
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "netspeed",
              "cpu"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "integerAtLeast",
            "minimum": 0
          }
        }
      ]
    },
    {
      "id": "powerMode",
      "label": {
        "zh": "电源操作",
        "en": "Power action"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "sleep"
          },
          "label": {
            "zh": "睡眠",
            "en": "Sleep"
          }
        },
        {
          "value": {
            "text": "hibernate"
          },
          "label": {
            "zh": "休眠",
            "en": "Hibernate"
          }
        },
        {
          "value": {
            "text": "shutdown"
          },
          "label": {
            "zh": "关机",
            "en": "Off"
          }
        },
        {
          "value": {
            "text": "restart"
          },
          "label": {
            "zh": "重启",
            "en": "Reboot"
          }
        }
      ],
      "default": {
        "text": "sleep"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "countdown",
              "specific_time",
              "netspeed",
              "cpu"
            ]
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "dryrun",
      "label": {
        "zh": "预演",
        "en": "dry-run"
      },
      "description": {
        "zh": "仅模拟电源操作，不改变系统状态。",
        "en": "Simulate the power action without changing system state."
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "countdown",
              "specific_time",
              "netspeed",
              "cpu"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "trigger",
      "title": {
        "zh": "触发序列",
        "en": "Trigger sequence"
      },
      "description": {
        "zh": "选择计时或监控方式，并直接修改当前参数。",
        "en": "Choose a timer or monitor and edit its parameters in place."
      },
      "fieldIds": [
        "action",
        "hours",
        "minutes",
        "seconds",
        "targetDatetime",
        "uploadThreshold",
        "downloadThreshold",
        "netDuration",
        "netTriggerMode",
        "cpuThreshold",
        "cpuDuration",
        "maxWaitSeconds"
      ]
    },
    {
      "id": "execution",
      "title": {
        "zh": "执行动作",
        "en": "Power action"
      },
      "description": {
        "zh": "确认电源动作和演练状态后直接启动或停止。",
        "en": "Review safety mode, then start or stop the task."
      },
      "fieldIds": [
        "powerMode",
        "dryrun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "powerMode",
      "slot": "powerMode",
      "transform": "trim"
    },
    {
      "fieldId": "hours",
      "slot": "hours",
      "transform": "asInteger"
    },
    {
      "fieldId": "minutes",
      "slot": "minutes",
      "transform": "asInteger"
    },
    {
      "fieldId": "seconds",
      "slot": "seconds",
      "transform": "asInteger"
    },
    {
      "fieldId": "targetDatetime",
      "slot": "targetDatetime",
      "transform": "identity"
    },
    {
      "fieldId": "uploadThreshold",
      "slot": "uploadThreshold",
      "transform": "asInteger"
    },
    {
      "fieldId": "downloadThreshold",
      "slot": "downloadThreshold",
      "transform": "asInteger"
    },
    {
      "fieldId": "netDuration",
      "slot": "netDuration",
      "transform": "identity"
    },
    {
      "fieldId": "netTriggerMode",
      "slot": "netTriggerMode",
      "transform": "trim"
    },
    {
      "fieldId": "cpuThreshold",
      "slot": "cpuThreshold",
      "transform": "asInteger"
    },
    {
      "fieldId": "cpuDuration",
      "slot": "cpuDuration",
      "transform": "identity"
    },
    {
      "fieldId": "dryrun",
      "slot": "dryrun",
      "transform": "asBoolean"
    },
    {
      "fieldId": "maxWaitSeconds",
      "slot": "maxWaitSeconds",
      "transform": "asInteger"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "get_stats"
          ]
        },
        "negated": true
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryrun"
        },
        "negated": true
      }
    ]
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "需要从工作区 UI 或 CLI 使用此节点的系统工作流时，可使用 Sleept。"
      ],
      "en": [
        "Use Sleept when you need this node's system workflow from either the workspace UI or CLI."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "从模块库部署 Sleept，并在节点面板中运行。",
          "en": "Deploy Sleept from the module registry and run it from the node surface."
        },
        "ui": {
          "zh": [
            "打开模块库，将 Sleept 部署到当前工作区。",
            "填写节点字段，或将路径/配置粘贴到节点面板。",
            "先运行预览或主操作，查看结果与日志后再实际应用变更。"
          ],
          "en": [
            "Open the module registry and deploy Sleept to the current workspace.",
            "Fill the node fields or paste paths/configuration into the node surface.",
            "Run preview or the primary action, then review results and logs before applying live changes."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "直接在终端中运行 Sleept。",
          "en": "Run Sleept directly from a terminal."
        },
        "cli": {
          "zh": [
            "当命令支持交互式提示时，运行 `xiranite sleept` 进入引导模式。",
            "运行 `xiranite sleept --help` 查看节点命令的具体标志与子命令。"
          ],
          "en": [
            "Run `xiranite sleept` for the guided mode when the command supports interactive prompts.",
            "Run `xiranite sleept --help` for the node command's exact flags and subcommands."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "节点 CLI",
          "en": "Node CLI"
        },
        "command": "xiranite sleept",
        "description": {
          "zh": "打开节点 CLI 或查看命令专属标志。",
          "en": "Open the node CLI or inspect command-specific flags."
        },
        "examples": [
          {
            "label": {
              "zh": "引导模式",
              "en": "Guided mode"
            },
            "command": "xiranite sleept",
            "description": {
              "zh": "启动节点的交互式终端工作流。",
              "en": "Start the node's interactive terminal workflow."
            }
          },
          {
            "label": {
              "zh": "命令标志",
              "en": "Command flags"
            },
            "command": "xiranite sleept --help",
            "description": {
              "zh": "查看节点 CLI 的子命令与选项。",
              "en": "Show the node CLI's subcommands and options."
            }
          },
          {
            "label": {
              "zh": "共享帮助",
              "en": "Shared help"
            },
            "command": "xiranite help sleept",
            "description": {
              "zh": "在根 CLI 中渲染此共享帮助条目。",
              "en": "Render this shared help entry in the root CLI."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "notes": {
        "zh": [
          "在实际运行前，先检查配置与受影响的系统状态。",
          "可用时优先使用预览模式。"
        ],
        "en": [
          "Review configuration and affected system state before running live actions.",
          "Prefer preview modes when available."
        ]
      }
    }
  }
}
