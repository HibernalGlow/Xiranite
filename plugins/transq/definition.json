{
  "definitionVersion": 1,
  "nodeId": "transq",
  "title": {
    "zh": "TransQ",
    "en": "TransQ"
  },
  "description": {
    "zh": "使用原生文件系统操作整理漫画翻译结果队列。",
    "en": "Organize manga-translator result queues with native filesystem operations."
  },
  "actions": [
    {
      "id": "status",
      "label": {
        "zh": "◌ 状态",
        "en": "Status"
      }
    },
    {
      "id": "plan",
      "label": {
        "zh": "⌕ 预演队列",
        "en": "Plan queue"
      }
    },
    {
      "id": "run",
      "label": {
        "zh": "↳ 整理队列",
        "en": "Organize queue"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "队列操作",
        "en": "Queue action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "status"
          },
          "label": {
            "zh": "◌ 状态",
            "en": "Status"
          }
        },
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌕ 预演队列",
            "en": "Plan queue"
          }
        },
        {
          "value": {
            "text": "run"
          },
          "label": {
            "zh": "↳ 整理队列",
            "en": "Organize queue"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "paths",
      "label": {
        "zh": "翻译工作区",
        "en": "Translation roots"
      },
      "kind": "path-list",
      "lines": 5,
      "placeholder": {
        "zh": "每行一个项目根目录",
        "en": "One project root per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "status"
                ]
              },
              "negated": true
            }
          }
        }
      ]
    },
    {
      "id": "preview",
      "label": {
        "zh": "仅预演",
        "en": "Preview only"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "status"
            ]
          },
          "negated": true
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "queue",
      "title": {
        "zh": "翻译队列",
        "en": "Translation queue"
      },
      "fieldIds": [
        "action",
        "paths",
        "preview"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "paths",
      "slot": "paths",
      "transform": "lines"
    },
    {
      "fieldId": "preview",
      "slot": "preview",
      "transform": "asBoolean",
      "defaultExport": "default_preview"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "run"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "preview"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认整理翻译队列",
      "en": "Confirm queue organization"
    },
    "body": {
      "zh": "将补齐缺失图片、移动 result，并删除已完成的工作目录。",
      "en": "Missing images will be copied; results move and work folders are removed."
    },
    "confirmLabel": {
      "zh": "确认整理",
      "en": "Organize"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": true,
  "help": {
    "whenToUse": {
      "zh": [
        "当 manga-translator 已生成 original_images/manga_translator_work/result 时使用 TransQ。",
        "需要在改动工作区前检查映射文件缺失或输出目录冲突时，先运行预演。"
      ],
      "en": [
        "Use TransQ after manga-translator has produced an original_images/manga_translator_work/result folder.",
        "Preview first when you need to identify missing mapped files or output-folder conflicts before changing the workspace."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "工作区 UI",
          "en": "Workspace UI"
        },
        "summary": {
          "zh": "先预演翻译队列，再确认整理安全的队列。",
          "en": "Preview translation queues, then confirm the queues that are safe to organize."
        },
        "ui": {
          "zh": [
            "添加一个或多个翻译项目根目录；TransQ 会递归扫描其中的 original_images 工作区。",
            "检查待补齐、可整理、已输出和冲突四条泳道。",
            "检查阶段保持预演开启；确认队列无误后关闭预演，再确认整理操作。"
          ],
          "en": [
            "Add one or more translation project roots; TransQ scans their nested original_images workspaces recursively.",
            "Review the Needs copy, Ready, Output, and Conflict lanes.",
            "Keep Preview enabled for inspection. Disable it only when the queue is ready, then confirm the organize action."
          ]
        }
      },
      {
        "title": {
          "zh": "CLI",
          "en": "CLI"
        },
        "summary": {
          "zh": "从终端直接规划或整理翻译队列。",
          "en": "Plan or organize translation queues directly from a terminal."
        },
        "cli": {
          "zh": [
            "运行 `xiranite transq plan D:/translation/project` 检查队列，不改动文件。",
            "运行 `xiranite transq run D:/translation/project --live` 应用已检查的队列。",
            "路径使用 `-` 时可从标准输入读取项目根目录。"
          ],
          "en": [
            "Run `xiranite transq plan D:/translation/project` to inspect queues without changing files.",
            "Run `xiranite transq run D:/translation/project --live` to apply a reviewed queue.",
            "Pass `-` as the path to read project roots from stdin."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "预演队列",
          "en": "Preview queues"
        },
        "command": "xiranite transq plan <path>",
        "description": {
          "zh": "扫描工作区并报告待复制项、输出位置、缺失文件和冲突，不改动文件。",
          "en": "Scan workspaces and report copies, outputs, missing files, and conflicts without changing files."
        },
        "examples": [
          {
            "label": {
              "zh": "预演一个项目",
              "en": "Preview one project"
            },
            "command": "xiranite transq plan D:/translation/project"
          },
          {
            "label": {
              "zh": "从标准输入预演",
              "en": "Preview paths from stdin"
            },
            "command": "Get-Content projects.txt | xiranite transq plan -"
          }
        ]
      },
      {
        "title": {
          "zh": "整理队列",
          "en": "Organize queues"
        },
        "command": "xiranite transq run <path> --live",
        "description": {
          "zh": "补齐结果目录缺失的映射原图，清理翻译工作文件，移动 result，并删除已完成的 original_images。",
          "en": "Copy mapped originals missing from result, remove translator work artifacts, move result, and remove the completed original_images folder."
        },
        "examples": [
          {
            "label": {
              "zh": "应用已检查队列",
              "en": "Apply a reviewed queue"
            },
            "command": "xiranite transq run D:/translation/project --live"
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "preview",
      "destructive": {
        "zh": [
          "真实执行会在结果目录成功移动后删除翻译工作文件和已完成的 original_images 目录。",
          "目标 result 已存在时会标记为冲突，绝不会自动覆盖。"
        ],
        "en": [
          "Live mode removes translator work artifacts and the completed original_images folder after the result directory has moved successfully.",
          "An existing output result folder is treated as a conflict and is never overwritten automatically."
        ]
      },
      "notes": {
        "zh": [
          "真实执行前立即对同一项目再预演一次。",
          "处理无法重新生成的翻译项目时请保留备份。"
        ],
        "en": [
          "Preview the same project immediately before a live run.",
          "Keep a backup when processing translation projects that cannot be regenerated."
        ]
      }
    }
  }
}
