{
  "definitionVersion": 1,
  "nodeId": "classf",
  "title": {
    "zh": "ClassF",
    "en": "ClassF"
  },
  "description": {
    "zh": "递归检测所有文件，并在不丢失路径分类的前提下分流到 already、del 或 wait。",
    "en": "Classify detected files into already, del, or wait without losing path context."
  },
  "actions": [
    {
      "id": "plan",
      "label": {
        "zh": "预演",
        "en": "Plan"
      }
    },
    {
      "id": "classify",
      "label": {
        "zh": "执行",
        "en": "Classify"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "预演",
            "en": "Plan"
          }
        },
        {
          "value": {
            "text": "classify"
          },
          "label": {
            "zh": "执行",
            "en": "Classify"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "pathsText",
      "label": {
        "zh": "SameA 压缩包根目录",
        "en": "SameA archive roots"
      },
      "kind": "path-list",
      "lines": 4,
      "placeholder": {
        "zh": "每行一个压缩包根目录",
        "en": "One archive root per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "crashuSourcesText",
      "label": {
        "zh": "CrashU 匹配源目录",
        "en": "CrashU source directories"
      },
      "kind": "path-list",
      "lines": 3,
      "placeholder": {
        "zh": "每行一个匹配源目录",
        "en": "One matching source directory per line"
      },
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "placementMode",
      "label": {
        "zh": "放置位置",
        "en": "Placement"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "local"
          },
          "label": {
            "zh": "文件所在目录",
            "en": "Beside each file"
          }
        },
        {
          "value": {
            "text": "root"
          },
          "label": {
            "zh": "给定根目录（保留相对路径）",
            "en": "Target root (preserve paths)"
          }
        }
      ],
      "default": {
        "text": "local"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "targetDir",
      "label": {
        "zh": "分流目标根目录",
        "en": "Classification target root"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "required"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "fieldEquals",
                "fieldId": "placementMode",
                "value": {
                  "text": "root"
                }
              },
              "negated": false
            }
          }
        }
      ]
    },
    {
      "id": "transferMode",
      "label": {
        "zh": "迁移方式",
        "en": "Transfer mode"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "move"
          },
          "label": {
            "zh": "移动",
            "en": "Move"
          }
        },
        {
          "value": {
            "text": "copy"
          },
          "label": {
            "zh": "复制",
            "en": "Copy"
          }
        }
      ],
      "default": {
        "text": "move"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "alreadyEnabled",
      "label": {
        "zh": "启用 already 队列",
        "en": "Enable already queue"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "waitEnabled",
      "label": {
        "zh": "启用 wait 队列",
        "en": "Enable wait queue"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "delEnabled",
      "label": {
        "zh": "启用 del 队列",
        "en": "Enable del queue"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "existingPolicy",
      "label": {
        "zh": "现有项目策略",
        "en": "Existing policy"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "merge"
          },
          "label": {
            "zh": "合并",
            "en": "Merge"
          }
        },
        {
          "value": {
            "text": "skip"
          },
          "label": {
            "zh": "跳过",
            "en": "Skip"
          }
        }
      ],
      "default": {
        "text": "merge"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "workItemMode",
      "label": {
        "zh": "作品类型",
        "en": "Work item type"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "files"
          },
          "label": {
            "zh": "压缩包文件",
            "en": "Archive files"
          }
        },
        {
          "value": {
            "text": "folders"
          },
          "label": {
            "zh": "已解压文件夹",
            "en": "Extracted folders"
          }
        },
        {
          "value": {
            "text": "mixed"
          },
          "label": {
            "zh": "压缩包 + 文件夹",
            "en": "Archives + folders"
          }
        }
      ],
      "default": {
        "text": "files"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "blacklistKeywordsText",
      "label": {
        "zh": "黑名单作者",
        "en": "Blacklisted authors"
      },
      "kind": "multiline",
      "lines": 5,
      "default": {
        "text": "[OgoG]\n[ぶたコマ300g]\n[すいせいむし]\n[ダツマ69]\n[ヤキカルビー]"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "sameaGroupAlreadyEnabled",
      "label": {
        "zh": "already 队列画师分组",
        "en": "Group already artists"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "sameaGroupWaitEnabled",
      "label": {
        "zh": "wait 队列画师分组",
        "en": "Group wait artists"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "sameaGroupDelEnabled",
      "label": {
        "zh": "del 队列画师分组",
        "en": "Group del artists"
      },
      "kind": "boolean",
      "default": {
        "boolean": false
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "sameaGroupMinOccurrences",
      "label": {
        "zh": "画师最少文件数",
        "en": "Minimum files per artist group"
      },
      "kind": "number",
      "range": {
        "min": 1,
        "max": 100,
        "step": 1
      },
      "default": {
        "number": 1
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "pathsText",
      "slot": "paths",
      "transform": "delimited"
    },
    {
      "fieldId": "crashuSourcesText",
      "slot": "crashuSourcePaths",
      "transform": "delimited"
    },
    {
      "fieldId": "placementMode",
      "slot": "placementMode",
      "transform": "trim"
    },
    {
      "fieldId": "targetDir",
      "slot": "targetDir",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "transferMode",
      "slot": "transferMode",
      "transform": "trim"
    },
    {
      "fieldId": "alreadyEnabled",
      "slot": "alreadyEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "waitEnabled",
      "slot": "waitEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "delEnabled",
      "slot": "delEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "existingPolicy",
      "slot": "existingPolicy",
      "transform": "trim"
    },
    {
      "fieldId": "workItemMode",
      "slot": "workItemMode",
      "transform": "trim"
    },
    {
      "fieldId": "blacklistKeywordsText",
      "slot": "blacklistKeywords",
      "transform": "delimited"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    },
    {
      "fieldId": "sameaGroupAlreadyEnabled",
      "slot": "sameaGroupAlreadyEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "sameaGroupWaitEnabled",
      "slot": "sameaGroupWaitEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "sameaGroupDelEnabled",
      "slot": "sameaGroupDelEnabled",
      "transform": "asBoolean"
    },
    {
      "fieldId": "sameaGroupMinOccurrences",
      "slot": "sameaGroupMinOccurrences",
      "transform": "asInteger"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "classify"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认执行 ClassF 管道",
      "en": "Confirm ClassF pipeline"
    },
    "body": {
      "zh": "MigrateF 将按已确认计划对文件系统执行真实操作。",
      "en": "MigrateF will apply the reviewed filesystem transfer plan."
    },
    "confirmLabel": {
      "zh": "确认执行",
      "en": "Run pipeline"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false,
  "help": {
    "whenToUse": {
      "zh": [
        "当多层文件夹需要递归分类，但不能打散或抹掉原有路径层级时使用 ClassF。"
      ],
      "en": [
        "Use ClassF when nested archive trees must be classified without flattening their existing directory structure."
      ]
    },
    "workflows": [
      {
        "title": {
          "zh": "自动分类",
          "en": "Pipeline classify"
        },
        "summary": {
          "zh": "递归检测文件，并在每个文件当前所在目录下创建 already 或 wait。",
          "en": "Detect every file recursively and classify it below its own current directory."
        },
        "ui": {
          "zh": [
            "粘贴来源根目录。",
            "选择“文件所在目录”。",
            "在真实分类前检查完整文件树。"
          ],
          "en": [
            "Copy SameA archive roots to the clipboard.",
            "Run the default pipeline preview.",
            "Review the pipeline result before live classify."
          ]
        }
      },
      {
        "title": {
          "zh": "根目录分流",
          "en": "Target-root classify"
        },
        "summary": {
          "zh": "在给定根目录下创建 already/wait，并保留来源根目录以下的完整相对路径。",
          "en": "Create already and wait below one target root while preserving every source-relative directory."
        },
        "ui": {
          "zh": [
            "选择“给定根目录”。",
            "填写目标根目录。",
            "选择移动或复制，然后先检查计划。"
          ],
          "en": [
            "Select root placement.",
            "Set the target root.",
            "Choose move or copy, then review the complete tree first."
          ]
        }
      }
    ],
    "commands": [
      {
        "title": {
          "zh": "预览自动分类",
          "en": "Preview auto classify"
        },
        "command": "xiranite classf plan D:/set --classify auto --placement local",
        "description": {
          "zh": "预览每个文件所在目录下的 already/wait 分流。",
          "en": "Preview selected and wait transfers."
        },
        "examples": [
          {
            "label": {
              "zh": "复制到目标根目录",
              "en": "Copy to target root"
            },
            "command": "xiranite classf classify D:/set --classify auto --placement root --target D:/done --transfer copy",
            "description": {
              "zh": "保留相对路径并复制到目标根目录下的 already/wait。",
              "en": "Copy files below target-root already/wait while preserving relative paths."
            }
          },
          {
            "label": {
              "zh": "添加黑名单关键词",
              "en": "Add a blacklist keyword"
            },
            "command": "xiranite classf plan D:/set --blacklist-keyword \"[Circle (Artist)]\"",
            "description": {
              "zh": "SameA 标签命中关键词时进入 del；CrashU 已匹配的项目仍优先进入 already。",
              "en": "SameA artist labels matching a keyword move to del unless CrashU already matches them."
            }
          },
          {
            "label": {
              "zh": "Choose independent queues",
              "en": "Choose independent queues"
            },
            "command": "xiranite classf plan D:/set --no-already --wait --del --samea-group-wait",
            "description": {
              "zh": "Queue and SameA grouping flags can be enabled independently; --classify remains available for legacy scripts.",
              "en": "Queue and SameA grouping flags can be enabled independently; --classify remains available for legacy scripts."
            }
          }
        ]
      }
    ],
    "safety": {
      "defaultMode": "dry-run",
      "destructive": {
        "zh": [
          "classify"
        ],
        "en": [
          "classify"
        ]
      },
      "notes": {
        "zh": [
          "UI 中的真实移动/复制需要二次确认。",
          "已存在的目标会被作为冲突报告并跳过。"
        ],
        "en": [
          "Live move/copy is gated by confirmation in the UI.",
          "Existing targets are reported as conflicts and skipped."
        ]
      }
    }
  }
}
