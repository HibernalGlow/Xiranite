{
  "definitionVersion": 1,
  "nodeId": "classq",
  "title": {
    "zh": "ClassQ",
    "en": "ClassQ"
  },
  "description": {
    "zh": "查找关键词文件夹并将同级项移入 wait 文件夹。",
    "en": "Find keyword folders and move sibling items into wait folders."
  },
  "actions": [
    {
      "id": "plan",
      "label": {
        "zh": "⌕ 扫描计划",
        "en": "Plan"
      },
      "helpKey": "action.plan"
    },
    {
      "id": "classify",
      "label": {
        "zh": "↳ 分类执行",
        "en": "Classify"
      },
      "helpKey": "action.classify"
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "工作流",
        "en": "Workflow"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "plan"
          },
          "label": {
            "zh": "⌕ 扫描计划",
            "en": "Plan"
          }
        },
        {
          "value": {
            "text": "classify"
          },
          "label": {
            "zh": "↳ 分类执行",
            "en": "Classify"
          }
        }
      ],
      "default": {
        "text": "plan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "paths",
      "label": {
        "zh": "输入根目录",
        "en": "Root directories"
      },
      "description": {
        "zh": "每行一个，递归发现关键词目录。",
        "en": "One root per line."
      },
      "kind": "path-list",
      "lines": 6,
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "atLeastLines",
            "minimum": 1
          }
        }
      ]
    },
    {
      "id": "keyword",
      "label": {
        "zh": "关键词目录",
        "en": "Keyword folder"
      },
      "kind": "text",
      "default": {
        "text": "already"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "waitKeyword",
      "label": {
        "zh": "等待目录",
        "en": "Wait folder"
      },
      "kind": "text",
      "default": {
        "text": "wait"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "transferMode",
      "label": {
        "zh": "传输方式",
        "en": "Transfer"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "move"
          },
          "label": {
            "zh": "移动",
            "en": "Move"
          }
        },
        {
          "value": {
            "text": "copy"
          },
          "label": {
            "zh": "复制",
            "en": "Copy"
          }
        }
      ],
      "default": {
        "text": "move"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "classify"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "existingPolicy",
      "label": {
        "zh": "目标冲突",
        "en": "Existing target"
      },
      "kind": "select",
      "options": [
        {
          "value": {
            "text": "merge"
          },
          "label": {
            "zh": "报告冲突",
            "en": "Report conflict"
          }
        },
        {
          "value": {
            "text": "skip"
          },
          "label": {
            "zh": "跳过",
            "en": "Skip"
          }
        }
      ],
      "default": {
        "text": "merge"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "classify"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    },
    {
      "id": "dryRun",
      "label": {
        "zh": "仅预演",
        "en": "Dry run"
      },
      "kind": "boolean",
      "default": {
        "boolean": true
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "actionIs",
            "actionField": "action",
            "allowed": [
              "classify"
            ]
          },
          "negated": false
        }
      },
      "rules": []
    }
  ],
  "groups": [
    {
      "id": "routing",
      "title": {
        "zh": "路由规则",
        "en": "Routing"
      },
      "fieldIds": [
        "action",
        "paths",
        "keyword",
        "waitKeyword",
        "transferMode",
        "existingPolicy",
        "dryRun"
      ]
    }
  ],
  "inputBindings": [
    {
      "fieldId": "action",
      "slot": "action",
      "transform": "trim"
    },
    {
      "fieldId": "paths",
      "slot": "paths",
      "transform": "delimited"
    },
    {
      "fieldId": "keyword",
      "slot": "keyword",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "waitKeyword",
      "slot": "waitKeyword",
      "transform": "trimOrOmit"
    },
    {
      "fieldId": "transferMode",
      "slot": "transferMode",
      "transform": "trim"
    },
    {
      "fieldId": "existingPolicy",
      "slot": "existingPolicy",
      "transform": "trim"
    },
    {
      "fieldId": "dryRun",
      "slot": "dryRun",
      "transform": "asBoolean"
    }
  ],
  "danger": {
    "type": "all",
    "predicates": [
      {
        "test": {
          "type": "actionIs",
          "actionField": "action",
          "allowed": [
            "classify"
          ]
        },
        "negated": false
      },
      {
        "test": {
          "type": "fieldTrue",
          "fieldId": "dryRun"
        },
        "negated": true
      }
    ]
  },
  "dangerPrompt": {
    "title": {
      "zh": "确认真实分类",
      "en": "Confirm live classify"
    },
    "body": {
      "zh": "将移动或复制所有就绪项；冲突项会保留为报告。",
      "en": "Ready items will be transferred; conflicts remain reported."
    },
    "confirmLabel": {
      "zh": "确认分类",
      "en": "Classify"
    }
  },
  "previewExport": "preview",
  "resultExport": "result_view",
  "reportsProgress": true,
  "publishesOutputPath": false
}
