{
  "name": "@xiranite/quickjs-shims",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "node: builtin shims for Xiranite node bundles executed by the embedded QuickJS host.",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts",
    "./surface": "./src/surface.ts",
    "./host": "./src/host.ts",
    "./fs": "./src/fs.ts",
    "./fs/promises": "./src/fs-promises.ts",
    "./path": "./src/path.ts",
    "./child_process": "./src/child-process.ts",
    "./os": "./src/os.ts",
    "./util": "./src/util.ts",
    "./crypto": "./src/crypto.ts",
    "./url": "./src/url.ts",
    "./process": "./src/process.ts",
    "./buffer": "./src/buffer.ts",
    "./events": "./src/events.ts",
    "./string_decoder": "./src/string-decoder.ts",
    "./stream": "./src/stream.ts",
    "./zlib": "./src/zlib.ts",
    "./readline": "./src/readline.ts"
  },
  "files": ["src"],
  "scripts": {
    "check:types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --maxWorkers=1"
  },
  "dependencies": {
    "@xiranite/config": "workspace:*",
    "brotli": "^1.3.3",
    "node-assert": "npm:assert@^2.1.0",
    "node-buffer": "npm:buffer@^6.0.3",
    "node-events": "npm:events@^3.3.0",
    "node-string-decoder": "npm:string_decoder@^1.3.0",
    "readable-stream": "^4.7.0",
    "safe-buffer": "^5.2.1"
  },
  "devDependencies": {
    "@types/readable-stream": "^4.0.25",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
