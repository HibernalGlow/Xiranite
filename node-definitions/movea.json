{
  "definitionVersion": 1,
  "nodeId": "movea",
  "title": {
    "zh": "Movea",
    "en": "Movea"
  },
  "description": {
    "zh": "扫描一级文件夹，将归档文件或散装文件夹移动到编号目标位置。",
    "en": "Scan first-level folders and move archives or loose folders into numbered targets."
  },
  "actions": [
    {
      "id": "scan",
      "label": {
        "zh": "⌁ 扫描目录",
        "en": "⌁ Scan"
      }
    },
    {
      "id": "match",
      "label": {
        "zh": "◇ 路由匹配",
        "en": "◇ Match"
      }
    },
    {
      "id": "move_single",
      "label": {
        "zh": "→ 移动单组",
        "en": "→ Move group"
      }
    },
    {
      "id": "move",
      "label": {
        "zh": "⇉ 批量移动",
        "en": "⇉ Move all"
      }
    }
  ],
  "fields": [
    {
      "id": "action",
      "label": {
        "zh": "操作",
        "en": "Action"
      },
      "kind": "select",
      "isActionSelector": true,
      "options": [
        {
          "value": {
            "text": "scan"
          },
          "label": {
            "zh": "⌁ 扫描目录",
            "en": "⌁ Scan"
          }
        },
        {
          "value": {
            "text": "match"
          },
          "label": {
            "zh": "◇ 路由匹配",
            "en": "◇ Match"
          }
        },
        {
          "value": {
            "text": "move_single"
          },
          "label": {
            "zh": "→ 移动单组",
            "en": "→ Move group"
          }
        },
        {
          "value": {
            "text": "move"
          },
          "label": {
            "zh": "⇉ 批量移动",
            "en": "⇉ Move all"
          }
        }
      ],
      "default": {
        "text": "scan"
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "oneOfDeclaredOptions"
          }
        }
      ]
    },
    {
      "id": "rootPath",
      "label": {
        "zh": "根目录",
        "en": "Root path"
      },
      "kind": "text",
      "default": {
        "text": ""
      },
      "visible": {
        "type": "single",
        "predicate": {
          "test": {
            "type": "always"
          },
          "negated": false
        }
      },
      "rules": [
        {
          "rule": {
            "type": "required"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "match"
                ]
              },
              "negated": true
            }
          }
        },
        {
          "rule": {
            "type": "nonBlank"
          },
          "when": {
            "type": "single",
            "predicate": {
              "test": {
                "type": "actionIs",
                "actionField": "action",
                "allowed": [
                  "match"
                ]
              },
              "negated": true
            }
          }
        }
